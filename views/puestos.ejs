<%- include('partials/header') %>
<h2 class="mb-4">Puestos</h2>

<p>A continuación se listan todos los puestos configurados en el sistema.  Puede editar el nombre del puesto, su departamento y a quién responde directamente.  También puede hacer clic en "Asignar KPIs" para definir qué indicadores aplican a cada puesto.  En la parte inferior puede crear nuevos departamentos, agregar sucursales al departamento OPERACIONES o crear un puesto nuevo.</p>

<%
  // Construir un mapa de departamentos para agrupar puestos.  Incluir
  // explícitamente todos los departamentos existentes (excepto BAJA) de modo
  // que se muestren incluso si no tienen puestos asignados.  También
  // incluir un grupo "SIN DEPARTAMENTO" para puestos sin departamento.
  const deptMap = {};
  if (Array.isArray(departamentos)) {
    departamentos.forEach(dep => {
      const name = (dep && dep.nombre) ? dep.nombre : '';
      if (name && name.toUpperCase() !== 'BAJA') {
        deptMap[name] = [];
      }
    });
  }
  // Grupo por defecto para puestos sin departamento o con departamento BAJA
  deptMap['SIN DEPARTAMENTO'] = deptMap['SIN DEPARTAMENTO'] || [];
  // Colocar cada puesto en su grupo correspondiente
  puestos.forEach(p => {
    let depName = p.departamento || 'SIN DEPARTAMENTO';
    // Si el puesto pertenece a BAJA, lo agrupamos en SIN DEPARTAMENTO para no mostrar BAJA
    if (depName && depName.toUpperCase() === 'BAJA') {
      depName = 'SIN DEPARTAMENTO';
    }
    if (!deptMap[depName]) {
      deptMap[depName] = [];
    }
    deptMap[depName].push(p);
  });
  // Determinar el orden de los departamentos.  Se prioriza un orden
  // predefinido y el resto se ordena alfabéticamente.
  const preferredOrder = ['DIRECCION', 'DIRECCIÓN', 'EYE', 'SISTEMAS', 'CAPITAL HUMANO', 'OPERACIONES'];
  const deptNames = Object.keys(deptMap).sort((a, b) => {
    const ia = preferredOrder.indexOf(a.toUpperCase());
    const ib = preferredOrder.indexOf(b.toUpperCase());
    if (ia !== -1 || ib !== -1) {
      if (ia === -1) return 1;
      if (ib === -1) return -1;
      return ia - ib;
    }
    return a.localeCompare(b, 'es');
  });
%>

<div class="accordion" id="puestosAccordion">
  <% deptNames.forEach((depName, depIdx) => { %>
    <% 
      // Copia y orden interno por claridad
      let list = deptMap[depName].slice();
      // Caso especial: EYE muestra primero GERENTE GENERAL (si existe)
      if ((depName || '').toUpperCase() === 'EYE') {
        list.sort((a, b) => {
          const aGG = (a.puesto || '').toUpperCase().includes('GERENTE GENERAL') ? 0 : 1;
          const bGG = (b.puesto || '').toUpperCase().includes('GERENTE GENERAL') ? 0 : 1;
          if (aGG !== bGG) return aGG - bGG;
          return (a.puesto || '').localeCompare((b.puesto || ''), 'es');
        });
      } else {
        list.sort((a, b) => (a.puesto || '').localeCompare((b.puesto || ''), 'es'));
      }
      const collapseId = `depCollapse_${depIdx}`;
      const headingId = `depHeading_${depIdx}`;
      const openByDefault = depIdx === 0; // abre la primera sección (ej. Dirección)
    %>

    <div class="accordion-item">
      <h2 class="accordion-header" id="<%= headingId %>">
        <button class="accordion-button <%= openByDefault ? '' : 'collapsed' %>" type="button"
                data-bs-toggle="collapse" data-bs-target="#<%= collapseId %>"
                aria-expanded="<%= openByDefault ? 'true' : 'false' %>" aria-controls="<%= collapseId %>">
          <strong><%= depName %></strong>
          <span class="badge bg-secondary ms-2"><%= list.length %></span>
        </button>
      </h2>
      <div id="<%= collapseId %>" class="accordion-collapse collapse <%= openByDefault ? 'show' : '' %>"
           aria-labelledby="<%= headingId %>" data-bs-parent="#puestosAccordion">
        <div class="accordion-body">
          <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th style="width:60px;">#</th>
                  <th>Puesto</th>
                  <th style="min-width:220px;">Responde a</th>
                  <th style="width:150px;">Rol</th>
                  <th style="width:220px;">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% list.forEach((p, idx) => { %>
                  <tr>
                    <form method="post" action="/puestos/editar/<%= p.id %>">
                      <td><%= idx + 1 %></td>
                      <td>
                        <input type="text" name="nombre" value="<%= p.puesto %>" class="form-control form-control-sm" required
                               <%= isAdmin ? '' : 'disabled' %>>
                        <div class="mt-1">
                          <select name="departamento_id" class="form-select form-select-sm" required <%= isAdmin ? '' : 'disabled' %>>
                            <% departamentos.forEach(dep => { %>
                              <option value="<%= dep.id %>" <%= dep.nombre === p.departamento ? 'selected' : '' %>><%= dep.nombre %></option>
                            <% }) %>
                          </select>
                        </div>
                      </td>
                      <td>
                        <select name="responde_a_id" class="form-select form-select-sm" <%= isAdmin ? '' : 'disabled' %>>
                          <option value="">Sin jefe directo</option>
                          <% 
                            // Ordenar puestos alfabéticamente por nombre de puesto para mostrar en el select
                            const sortedBosses = puestos
                              .filter(j => j.id !== p.id) // no permitir que un puesto se auto-se asigne como jefe
                              .slice()
                              .sort((a,b) => (a.puesto || '').localeCompare((b.puesto || ''), 'es'));
                            sortedBosses.forEach(j => { %>
                              <option value="<%= j.id %>" <%= (p.responde_id && j.id === p.responde_id) ? 'selected' : '' %>>
                                <%= j.puesto %>
                                <% if (j.departamento) { %> - <%= j.departamento %> <% } %>
                              </option>
                          <% }); %>
                        </select>
                      </td>
                      <td>
                        <% if (isAdmin) { %>
                          <select name="role" class="form-select form-select-sm">
                            <% roles.forEach(function(r) { %>
                              <option value="<%= r %>" <%= p.role === r ? 'selected' : '' %>><%= r.charAt(0).toUpperCase() + r.slice(1) %></option>
                            <% }); %>
                          </select>
                        <% } else { %>
                          <span class="badge bg-secondary"><%= (p.role || 'user').charAt(0).toUpperCase() + (p.role || 'user').slice(1) %></span>
                        <% } %>
                      </td>
                      <td class="text-nowrap">
                        <!-- Indicador numérico de KPIs asignados -->
                        <a href="/puestos/<%= p.id %>" class="badge bg-info text-dark me-1" title="KPIs asignados al puesto">
                          KPIs: <%= p.kpi_count %>
                        </a>
                        <a href="/puestos/<%= p.id %>" class="btn btn-sm btn-primary me-1">Asignar KPIs</a>
                        <% if (isAdmin) { %>
                          <button type="submit" class="btn btn-sm btn-success">Guardar</button>
                        <% } else { %>
                          <span class="badge bg-secondary">Solo lectura</span>
                        <% } %>
                      </td>
                    </form>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<hr>
<% if (isAdmin) { %>
  <h3>Crear Departamento</h3>
  <form method="post" action="/puestos/crear-departamento" class="row g-3 mb-4">
    <div class="col-auto">
      <input type="text" name="nombre" placeholder="Nombre del departamento" class="form-control" required>
    </div>
    <div class="col-auto">
      <button type="submit" class="btn btn-success">Agregar departamento</button>
    </div>
  </form>

  <h3>Asignar sucursales al Departamento OPERACIONES</h3>
  <% if (typeof operacionesDeptId !== 'undefined' && operacionesDeptId) { %>
    <div id="branch-management" data-dept-id="<%= operacionesDeptId %>">
      <div class="row row-cols-lg-auto g-2 align-items-center">
        <div class="col-12 col-lg-6">
          <select id="branch-select" class="form-select form-select-sm">
            <option value="">Selecciona una sucursal...</option>
            <% sucursales.forEach(function(s){ %>
              <option value="<%= s.id %>"><%= s.nombre %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-12 col-lg-auto">
          <button type="button" class="btn btn-success btn-sm" id="add-branch-btn">Agregar</button>
        </div>
      </div>
      <div class="mt-2">
        <table class="table table-sm table-bordered mb-2">
          <thead>
            <tr><th>Sucursal</th><th class="text-center" style="width:60px;">Acción</th></tr>
          </thead>
          <tbody id="assigned-branches-list">
            <!-- contenido generado por JS -->
          </tbody>
        </table>
      </div>
      <!-- Formulario opcional para crear una nueva sucursal si no existe -->
      <div class="mt-3">
        <form method="post" action="/puestos/crear-sucursal" class="row g-2 align-items-center">
          <div class="col-md-6">
            <input type="text" name="nombre" placeholder="Nueva sucursal" class="form-control form-control-sm" required>
          </div>
          <div class="col-auto">
            <button type="submit" class="btn btn-secondary btn-sm">Crear sucursal</button>
          </div>
        </form>
        <!-- Ajuste: cuando se crea una nueva sucursal aquí, se asigna automáticamente al departamento OPERACIONES -->
        <small class="text-muted">Si la sucursal no existe, puede crearla aquí; se creará directamente en el departamento OPERACIONES.</small>
      </div>
    </div>
  <% } else { %>
    <div class="alert alert-warning">No se encontró el departamento OPERACIONES. Verifique que exista en la base de datos.</div>
  <% } %>

  <hr>
  <h3>Crear Puesto</h3>
  <form method="post" action="/puestos/crear" class="row g-3">
    <div class="col-md-3">
      <input type="text" name="nombre" placeholder="Nombre del puesto" class="form-control" required>
    </div>
    <div class="col-md-3">
      <select name="departamento_id" class="form-select" required>
        <% departamentos.forEach(dep => { %>
          <option value="<%= dep.id %>"><%= dep.nombre %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-3">
      <select name="responde_a_id" class="form-select">
        <option value="">Sin jefe directo</option>
        <% 
          // Ordenar puestos alfabéticamente por nombre para el selector de jefe directo al crear
          const sortedBossesCreate = puestos.slice().sort((a,b) => (a.puesto || '').localeCompare((b.puesto || ''), 'es'));
          sortedBossesCreate.forEach(function(p) { %>
          <option value="<%= p.id %>">
            <%= p.puesto %>
            <% if (p.departamento) { %> - <%= p.departamento %> <% } %>
          </option>
        <% }); %>
      </select>
    </div>
    <div class="col-md-2">
      <select name="role" class="form-select">
        <% roles.forEach(function(r) { %>
          <option value="<%= r %>"><%= r.charAt(0).toUpperCase() + r.slice(1) %></option>
        <% }); %>
      </select>
    </div>
    <div class="col-md-2">
      <button type="submit" class="btn btn-success">Crear puesto</button>
    </div>
  </form>

    <!-- Script para gestionar sucursales asignadas al departamento OPERACIONES -->
    <script>
    document.addEventListener('DOMContentLoaded', function() {
      const container = document.getElementById('branch-management');
      if (!container) return;
      const deptId = container.getAttribute('data-dept-id');
      if (!deptId) return;
      const listBody = document.getElementById('assigned-branches-list');
      const selectEl = document.getElementById('branch-select');
      const addBtn = document.getElementById('add-branch-btn');
      async function loadAssigned() {
        try {
          const resp = await fetch('/departments/' + deptId + '/branches');
          const data = await resp.json();
          listBody.innerHTML = '';
          (data.branches || []).forEach(function(br) {
            const tr = document.createElement('tr');
            const tdName = document.createElement('td');
            tdName.textContent = br.nombre || '';
            const tdAction = document.createElement('td');
            tdAction.className = 'text-center';
            const delBtn = document.createElement('button');
            delBtn.type = 'button';
            delBtn.className = 'btn btn-sm btn-outline-danger';
            delBtn.setAttribute('data-branch-id', br.id);
            delBtn.innerHTML = '🗑️';
            tdAction.appendChild(delBtn);
            tr.appendChild(tdName);
            tr.appendChild(tdAction);
            listBody.appendChild(tr);
          });
        } catch (e) {
          console.error('No se pudieron cargar las sucursales asignadas:', e);
        }
      }
      if (addBtn) {
        addBtn.addEventListener('click', async function() {
          const branchId = selectEl.value;
          if (!branchId) return;
          addBtn.disabled = true;
          try {
            await fetch('/departments/' + deptId + '/branches', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({ branchId: branchId })
            });
          } catch (e) {
            console.error('Error al asignar sucursal:', e);
          }
          addBtn.disabled = false;
          selectEl.value = '';
          loadAssigned();
        });
      }
      listBody.addEventListener('click', async function(ev) {
        const btn = ev.target.closest('button[data-branch-id]');
        if (!btn) return;
        const id = btn.getAttribute('data-branch-id');
        btn.disabled = true;
        try {
          await fetch('/departments/' + deptId + '/branches/' + id, { method: 'DELETE' });
        } catch (e) {
          console.error('Error al eliminar sucursal:', e);
        }
        loadAssigned();
      });
      // Cargar lista inicial
      loadAssigned();
    });
    </script>
  <!-- Sección para asignar rutas de supervisión -->
  <hr>
  <h3>Administrar rutas de supervisión</h3>
  <p>Configure a qué ruta de supervisión (1–6) pertenece cada sucursal y qué supervisor o auxiliar de supervisión está a cargo de dicha ruta.</p>

  <!-- Resumen de rutas de supervisión: muestra cada ruta con sus supervisores y sucursales.  Los administradores pueden seleccionar una ruta para editarla. -->
  <div id="supervision-summary" class="mb-3"></div>

  <!-- Contenedor para la gestión detallada de una ruta.  Se oculta hasta que el usuario seleccione una ruta desde el resumen. -->
  <div id="supervision-management-container" style="display:none;">
    <h4 class="mt-3">Editar ruta de supervisión</h4>
    <p class="mb-2">Seleccione una ruta para asignar sucursales y colaboradores.</p>
    <div id="supervision-management" class="mb-4">
    <div class="row row-cols-lg-auto g-2 align-items-center mb-2">
      <div class="col-12 col-lg-3">
        <label for="supervision-route-select" class="form-label fw-bold mb-0">Ruta:</label>
        <select id="supervision-route-select" class="form-select form-select-sm">
          <option value="">Selecciona una ruta...</option>
        </select>
      </div>
      <div class="col-12 col-lg-3">
        <label for="supervision-branch-select" class="form-label fw-bold mb-0">Sucursal:</label>
        <select id="supervision-branch-select" class="form-select form-select-sm" disabled>
          <option value="">Selecciona una sucursal...</option>
        </select>
      </div>
      <div class="col-12 col-lg-auto">
        <button type="button" class="btn btn-success btn-sm" id="supervision-add-branch-btn" disabled>Agregar sucursal</button>
      </div>
      <div class="col-12 col-lg-3">
        <label for="supervision-employee-select" class="form-label fw-bold mb-0">Supervisor:</label>
        <select id="supervision-employee-select" class="form-select form-select-sm" disabled>
          <option value="">Selecciona un supervisor...</option>
        </select>
      </div>
      <div class="col-12 col-lg-auto">
        <button type="button" class="btn btn-success btn-sm" id="supervision-add-employee-btn" disabled>Asignar supervisor</button>
      </div>
    </div>
    <div class="row">
      <div class="col-md-6 mb-3">
        <h5>Sucursales asignadas</h5>
        <table class="table table-sm table-bordered mb-1">
          <thead>
            <tr><th>Sucursal</th><th class="text-center" style="width:60px;">Acción</th></tr>
          </thead>
          <tbody id="supervision-assigned-branches-list">
            <!-- se llena por JS -->
          </tbody>
        </table>
      </div>
      <div class="col-md-6 mb-3">
        <h5>Empleados asignados</h5>
        <table class="table table-sm table-bordered mb-1">
          <thead>
            <tr><th>Empleado</th><th>Puesto</th><th class="text-center" style="width:60px;">Acción</th></tr>
          </thead>
          <tbody id="supervision-assigned-employees-list">
            <!-- se llena por JS -->
          </tbody>
        </table>
      </div>
    </div><!-- fin div#supervision-management -->
  </div><!-- fin div#supervision-management-container -->
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    // Gestión de rutas de supervisión
    const routeSelect = document.getElementById('supervision-route-select');
    const branchSelect = document.getElementById('supervision-branch-select');
    const addBranchBtn = document.getElementById('supervision-add-branch-btn');
    const employeeSelect = document.getElementById('supervision-employee-select');
    const addEmployeeBtn = document.getElementById('supervision-add-employee-btn');
    const branchListBody = document.getElementById('supervision-assigned-branches-list');
    const employeeListBody = document.getElementById('supervision-assigned-employees-list');
    // Cargar rutas, sucursales y empleados elegibles
    async function loadRoutes() {
      try {
        const resp = await fetch('/supervision/routes');
        const data = await resp.json();
        routeSelect.innerHTML = '<option value="">Selecciona una ruta...</option>';
        (data.routes || []).forEach(function(rt) {
          const opt = document.createElement('option');
          opt.value = rt.id;
          opt.textContent = rt.nombre || ('Ruta ' + rt.id);
          routeSelect.appendChild(opt);
        });
      } catch (e) {
        console.error('Error al cargar rutas:', e);
      }
    }
    async function loadBranches() {
      try {
        const resp = await fetch('/branches');
        const data = await resp.json();
        branchSelect.innerHTML = '<option value="">Selecciona una sucursal...</option>';
        (data.branches || []).forEach(function(br) {
          const opt = document.createElement('option');
          opt.value = br.id;
          opt.textContent = br.nombre || '';
          branchSelect.appendChild(opt);
        });
      } catch (e) {
        console.error('Error al cargar sucursales para rutas:', e);
      }
    }
    async function loadEligibleEmployees() {
      try {
        const resp = await fetch('/supervision/eligible-employees');
        const data = await resp.json();
    employeeSelect.innerHTML = '<option value="">Selecciona un supervisor...</option>';
        (data.employees || []).forEach(function(emp) {
          const opt = document.createElement('option');
          opt.value = emp.id;
          opt.textContent = emp.nombre + ' (' + (emp.puesto || '') + ')';
          employeeSelect.appendChild(opt);
        });
      } catch (e) {
        console.error('Error al cargar empleados elegibles:', e);
      }
    }
    // Cargar listas asignadas según la ruta seleccionada
    async function loadAssignedForRoute(rutaId) {
      branchListBody.innerHTML = '';
      employeeListBody.innerHTML = '';
      if (!rutaId) {
        branchSelect.disabled = true;
        addBranchBtn.disabled = true;
        employeeSelect.disabled = true;
        addEmployeeBtn.disabled = true;
        return;
      }
      // Habilitar selects y botones
      branchSelect.disabled = false;
      addBranchBtn.disabled = false;
      employeeSelect.disabled = false;
      addEmployeeBtn.disabled = false;
      try {
        // Cargar sucursales de la ruta
        const respBranches = await fetch('/supervision/routes/' + rutaId + '/branches');
        const dataBranches = await respBranches.json();
        (dataBranches.branches || []).forEach(function(br) {
          const tr = document.createElement('tr');
          const tdName = document.createElement('td');
          tdName.textContent = br.nombre || '';
          const tdAction = document.createElement('td');
          tdAction.className = 'text-center';
          const delBtn = document.createElement('button');
          delBtn.type = 'button';
          delBtn.className = 'btn btn-sm btn-outline-danger';
          delBtn.setAttribute('data-branch-id', br.id);
          delBtn.innerHTML = '🗑️';
          tdAction.appendChild(delBtn);
          tr.appendChild(tdName);
          tr.appendChild(tdAction);
          branchListBody.appendChild(tr);
        });
        // Cargar empleados de la ruta
        const respEmp = await fetch('/supervision/routes/' + rutaId + '/employees');
        const dataEmp = await respEmp.json();
        (dataEmp.employees || []).forEach(function(emp) {
          const tr = document.createElement('tr');
          const tdName = document.createElement('td');
          tdName.textContent = emp.nombre || '';
          const tdPuesto = document.createElement('td');
          tdPuesto.textContent = emp.puesto || '';
          const tdAction = document.createElement('td');
          tdAction.className = 'text-center';
          const delBtn = document.createElement('button');
          delBtn.type = 'button';
          delBtn.className = 'btn btn-sm btn-outline-danger';
          delBtn.setAttribute('data-emp-id', emp.id);
          delBtn.innerHTML = '🗑️';
          tdAction.appendChild(delBtn);
          tr.appendChild(tdName);
          tr.appendChild(tdPuesto);
          tr.appendChild(tdAction);
          employeeListBody.appendChild(tr);
        });
      } catch (e) {
        console.error('Error al cargar asignaciones para la ruta:', e);
      }
    }
    // Inicializar datos globales
    loadRoutes();
    loadBranches();
    loadEligibleEmployees();
    loadSummary();
    // Manejador de cambio de ruta
    routeSelect.addEventListener('change', function() {
      const rutaId = routeSelect.value;
      loadAssignedForRoute(rutaId);
    });
    // Agregar sucursal a la ruta
    addBranchBtn.addEventListener('click', async function() {
      const rutaId = routeSelect.value;
      const branchId = branchSelect.value;
      if (!rutaId || !branchId) return;
      addBranchBtn.disabled = true;
      try {
        await fetch('/supervision/routes/' + rutaId + '/branches', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ branchId: branchId })
        });
      } catch (e) {
        console.error('Error al asignar sucursal a la ruta:', e);
      }
      branchSelect.value = '';
      addBranchBtn.disabled = false;
      loadAssignedForRoute(rutaId);
      loadSummary();
    });
    // Agregar empleado a la ruta
    addEmployeeBtn.addEventListener('click', async function() {
      const rutaId = routeSelect.value;
      const empId = employeeSelect.value;
      if (!rutaId || !empId) return;
      addEmployeeBtn.disabled = true;
      try {
        await fetch('/supervision/routes/' + rutaId + '/employees', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ employeeId: empId })
        });
      } catch (e) {
        console.error('Error al asignar empleado a la ruta:', e);
      }
      employeeSelect.value = '';
      addEmployeeBtn.disabled = false;
      loadAssignedForRoute(rutaId);
      loadSummary();
    });
    // Delegación de eventos para eliminación de sucursales o empleados
    branchListBody.addEventListener('click', async function(ev) {
      const btn = ev.target.closest('button[data-branch-id]');
      if (!btn) return;
      const rutaId = routeSelect.value;
      const branchId = btn.getAttribute('data-branch-id');
      btn.disabled = true;
      try {
        await fetch('/supervision/routes/' + rutaId + '/branches/' + branchId, { method: 'DELETE' });
      } catch (e) {
        console.error('Error al eliminar sucursal de la ruta:', e);
      }
      loadAssignedForRoute(rutaId);
      loadSummary();
    });
    employeeListBody.addEventListener('click', async function(ev) {
      const btn = ev.target.closest('button[data-emp-id]');
      if (!btn) return;
      const rutaId = routeSelect.value;
      const empId = btn.getAttribute('data-emp-id');
      btn.disabled = true;
      try {
        await fetch('/supervision/routes/' + rutaId + '/employees/' + empId, { method: 'DELETE' });
      } catch (e) {
        console.error('Error al eliminar empleado de la ruta:', e);
      }
      loadAssignedForRoute(rutaId);
      loadSummary();
    });

    // ---------------------------------------------------------------------
    // Resumen de rutas de supervisión
    // Muestra cada ruta con sus supervisores y número de sucursales.  Permite
    // seleccionar una ruta para editarla.
    async function loadSummary() {
      const summaryDiv = document.getElementById('supervision-summary');
      // Limpia contenido
      summaryDiv.innerHTML = '';
      try {
        // Obtener todas las rutas
        const respRoutes = await fetch('/supervision/routes');
        const dataRoutes = await respRoutes.json();
        const routes = dataRoutes.routes || [];
        if (!routes.length) {
          summaryDiv.innerHTML = '<p class="text-muted">No hay rutas definidas.</p>';
          return;
        }
        // Crear tabla
        const table = document.createElement('table');
        table.className = 'table table-sm table-bordered align-middle';
        const thead = document.createElement('thead');
        thead.innerHTML = '<tr><th>Ruta</th><th>Supervisor</th><th># Sucursales</th><th>Acciones</th></tr>';
        const tbody = document.createElement('tbody');
        for (const rt of routes) {
          const rutaId = rt.id;
          // Obtener empleados virtuales de la ruta
          const [empsData, branchesData] = await Promise.all([
            fetch('/supervision/routes/' + rutaId + '/employees').then(r => r.json()),
            fetch('/supervision/routes/' + rutaId + '/branches').then(r => r.json())
          ]);
          const employees = (empsData.employees || []);
          const branches = (branchesData.branches || []);
          // Mostrar responsable: supervisor de sucursal (puesto 46) asignado a la sucursal virtual de la ruta
          const supervisors = employees.filter(emp => Number(emp.puesto_id) === 46);
          const supervisorName = supervisors.length ? supervisors[0].nombre : null;
          const branchCount = branches.length;
          const tr = document.createElement('tr');
          const tdRuta = document.createElement('td');
          tdRuta.textContent = rutaId;
          const tdSup = document.createElement('td');
          if (supervisorName) {
            tdSup.innerHTML = `<span class="badge bg-dark me-2">Supervisor</span>${supervisorName}`;
          } else {
            tdSup.innerHTML = '<span class="text-muted">Sin supervisor asignado</span>';
          }
          const tdBranches = document.createElement('td');
          tdBranches.textContent = branchCount.toString();
          const tdAction = document.createElement('td');
          const btnEdit = document.createElement('button');
          btnEdit.type = 'button';
          btnEdit.className = 'btn btn-sm btn-primary';
          btnEdit.setAttribute('data-route-id', rutaId);
          btnEdit.textContent = 'Editar';
          tdAction.appendChild(btnEdit);
          tr.appendChild(tdRuta);
          tr.appendChild(tdSup);
          tr.appendChild(tdBranches);
          tr.appendChild(tdAction);
          tbody.appendChild(tr);
        }
        table.appendChild(thead);
        table.appendChild(tbody);
        summaryDiv.appendChild(table);
      } catch (e) {
        console.error('Error al cargar resumen de rutas:', e);
        summaryDiv.innerHTML = '<p class="text-danger">Error al cargar resumen de rutas.</p>';
      }
    }

    // Delegación para manejar clic en botones de edición de la tabla resumen
    document.getElementById('supervision-summary').addEventListener('click', function(ev) {
      const btn = ev.target.closest('button[data-route-id]');
      if (!btn) return;
      const rutaId = btn.getAttribute('data-route-id');
      // Seleccionar ruta en el formulario y cargar asignaciones
      routeSelect.value = rutaId;
      // Mostrar el contenedor de gestión detallada
      const managementContainer = document.getElementById('supervision-management-container');
      if (managementContainer) {
        managementContainer.style.display = '';
      }
      loadAssignedForRoute(rutaId);
    });
  });
  </script>
<% } else { %>
  <div class="alert alert-secondary mt-3" role="alert">
    Las acciones de creación de departamentos, sucursales y puestos están disponibles solo para administradores.
  </div>
<% } %>

<%- include('partials/footer') %>