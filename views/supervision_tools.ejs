<%- include('partials/header', { title: 'Rutas' }) %>

<h2 class="mb-3">Administración de rutas de supervisión y KPIs</h2>

<p>En esta sección los administradores pueden asignar sucursales, supervisor y colaboradores de Operaciones Sucursales a cada ruta de supervisión (1–6), además de exportar o importar los resultados de KPIs por periodo.</p>

<div class="card mb-4">
  <div class="card-body">
    <h4 class="h6 mb-2">Exportar e importar KPIs por periodo</h4>
    <div class="row g-2 align-items-end">
      <div class="col-auto">
        <label for="year-select" class="form-label mb-0">Año:</label>
        <select id="year-select" class="form-select form-select-sm"></select>
      </div>
      <div class="col-auto">
        <label for="month-select" class="form-label mb-0">Mes:</label>
        <select id="month-select" class="form-select form-select-sm"></select>
      </div>
      <div class="col-auto">
        <a id="export-all-btn" class="btn btn-sm btn-outline-success" href="#">Exportar todas las rutas (Excel)</a>
      </div>
      <div class="col-auto">
        <form id="import-form" method="post" action="/admin/supervision/import" enctype="multipart/form-data" class="d-flex align-items-center gap-2 flex-wrap">
          <input type="hidden" name="anio" id="import-year">
          <input type="hidden" name="mes" id="import-month">
          <input type="file" name="file" accept=".xlsx" class="form-control form-control-sm" required style="max-width:260px;">
          <button type="submit" class="btn btn-sm btn-primary">Importar (Excel)</button>
        </form>
      </div>
    </div>
    <div class="text-muted small mt-2">
      Exporta el documento, captura calificaciones y comentarios y vuelve a importarlo para guardar resultados masivamente.
    </div>
  </div>
</div>

<hr>

<h3 class="mb-3">Administrar rutas de supervisión</h3>
<p>Seleccione una ruta para asignar sucursales, supervisor y colaboradores. Los colaboradores se guardan como asignación manual de KPI y no se pierden al actualizar personal.</p>

<div id="supervision-summary" class="mb-3"></div>

<div id="supervision-management-container" style="display:none;">
  <h4 class="mt-3">Editar ruta de supervisión</h4>
  <p class="mb-2">Seleccione una ruta para asignar sucursales, supervisor y colaboradores.</p>

  <div class="card mb-3">
    <div class="card-body">
      <div class="row g-2 align-items-end">
        <div class="col-12 col-md-3">
          <label for="supervision-route-select" class="form-label fw-bold">Ruta</label>
          <select id="supervision-route-select" class="form-select form-select-sm">
            <option value="">Selecciona una ruta...</option>
          </select>
        </div>
        <div class="col-12 col-md-5">
          <label for="supervision-branch-select" class="form-label fw-bold">Sucursal</label>
          <select id="supervision-branch-select" class="form-select form-select-sm" disabled>
            <option value="">Selecciona una sucursal...</option>
          </select>
        </div>
        <div class="col-12 col-md-2">
          <button type="button" class="btn btn-success btn-sm w-100" id="supervision-add-branch-btn" disabled>Agregar sucursal</button>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-3">
    <div class="col-12 col-lg-5">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="h6 fw-bold">Supervisor de la ruta</h5>
          <div id="current-supervisor" class="alert alert-light border py-2 small">Sin supervisor asignado</div>
          <label for="supervision-employee-select" class="form-label fw-bold">Cambiar supervisor</label>
          <select id="supervision-employee-select" class="form-select form-select-sm mb-2" disabled>
            <option value="">Selecciona un supervisor...</option>
          </select>
          <button type="button" class="btn btn-primary btn-sm" id="supervision-add-employee-btn" disabled>Asignar supervisor</button>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-7">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="h6 fw-bold">Agregar colaborador a la ruta</h5>
          <div class="text-muted small mb-2">Busca empleados de Operaciones Sucursales o detectados por sucursal/departamento SUPERVISION 1–6.</div>
          <div class="row g-2 align-items-end">
            <div class="col-12 col-md-5">
              <label class="form-label">Buscar empleado</label>
              <input id="collab-search" class="form-control form-control-sm" placeholder="Ej. José, 3354, encargado..." disabled>
            </div>
            <div class="col-12 col-md-7">
              <label class="form-label">Empleado</label>
              <select id="collab-select" class="form-select form-select-sm" disabled>
                <option value="">Busca y selecciona un empleado...</option>
              </select>
            </div>
            <div class="col-12 col-md-4 form-check ms-2">
              <input class="form-check-input" type="checkbox" value="1" id="collab-hereda-kpis" checked disabled>
              <label class="form-check-label small" for="collab-hereda-kpis">Hereda KPIs</label>
            </div>
            <div class="col-12 col-md-5 form-check ms-2">
              <input class="form-check-input" type="checkbox" value="1" id="collab-hereda-calif" checked disabled>
              <label class="form-check-label small" for="collab-hereda-calif">Hereda calificación supervisor</label>
            </div>
            <div class="col-12 col-md-2">
              <button type="button" class="btn btn-success btn-sm w-100" id="collab-add-btn" disabled>Agregar</button>
            </div>
          </div>
          <div id="collab-search-status" class="text-muted small mt-2"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-12 col-lg-5">
      <h5 class="h6 fw-bold">Sucursales asignadas</h5>
      <table class="table table-sm table-bordered align-middle mb-1">
        <thead class="table-light">
          <tr><th>Sucursal</th><th class="text-center" style="width:80px;">Acción</th></tr>
        </thead>
        <tbody id="supervision-assigned-branches-list"></tbody>
      </table>
    </div>
    <div class="col-12 col-lg-7">
      <h5 class="h6 fw-bold">Colaboradores asignados manualmente</h5>
      <table class="table table-sm table-bordered align-middle mb-1">
        <thead class="table-light">
          <tr>
            <th>Empleado</th>
            <th>Puesto</th>
            <th>Departamento actual</th>
            <th class="text-center">Hereda KPIs</th>
            <th class="text-center">Hereda calif.</th>
            <th class="text-center" style="width:80px;">Acción</th>
          </tr>
        </thead>
        <tbody id="supervision-assigned-collaborators-list"></tbody>
      </table>

      <h5 class="h6 fw-bold mt-3">Empleados detectados automáticamente por sucursal virtual o departamento</h5>
      <div class="text-muted small mb-2">Estos empleados vienen de incidencias/CONTPAQ con sucursal virtual o departamento SUPERVISION 1–6. Solo aparecen si todavía no tienen asignación manual.</div>
      <table class="table table-sm table-bordered align-middle mb-1">
        <thead class="table-light">
          <tr>
            <th>Empleado</th>
            <th>Puesto</th>
            <th>Departamento actual</th>
            <th>Sucursal actual</th>
          </tr>
        </thead>
        <tbody id="supervision-auto-dept-list"></tbody>
      </table>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // --- Periodo dinámico ---
  const yearSelect = document.getElementById('year-select');
  const monthSelect = document.getElementById('month-select');
  const exportBtn = document.getElementById('export-all-btn');
  const importYear = document.getElementById('import-year');
  const importMonth = document.getElementById('import-month');
  const currentYear = Number(<%= selectedYear %>);
  const currentMonth = Number(<%= selectedMonth %>);
  for (let y = currentYear - 2; y <= currentYear + 1; y++) {
    const opt = document.createElement('option');
    opt.value = y;
    opt.textContent = y;
    if (y === currentYear) opt.selected = true;
    yearSelect.appendChild(opt);
  }
  const monthNames = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
  for (let i = 1; i <= 12; i++) {
    const opt = document.createElement('option');
    opt.value = i;
    opt.textContent = monthNames[i - 1];
    if (i === currentMonth) opt.selected = true;
    monthSelect.appendChild(opt);
  }
  function updateExportImport() {
    const y = yearSelect.value;
    const m = monthSelect.value;
    exportBtn.href = '/admin/supervision/export?anio=' + y + '&mes=' + m;
    importYear.value = y;
    importMonth.value = m;
  }
  yearSelect.addEventListener('change', updateExportImport);
  monthSelect.addEventListener('change', updateExportImport);
  updateExportImport();

  const importForm = document.getElementById('import-form');
  importForm.addEventListener('submit', function(e) {
    try {
      const y = parseInt(importYear.value, 10);
      const m = parseInt(importMonth.value, 10);
      const now = new Date();
      let defYear = now.getFullYear();
      let defMonth = now.getMonth() + 1;
      if (now.getDate() <= 26) {
        defMonth -= 1;
        if (defMonth < 1) { defMonth = 12; defYear -= 1; }
      }
      const isOlder = (y < defYear) || (y === defYear && m < defMonth);
      if (isOlder) {
        const msg = `El periodo ${monthNames[m-1]} ${y} ya está cerrado desde el 27 del mes siguiente. ¿Realmente desea sobreescribir los valores?`;
        if (!window.confirm(msg)) e.preventDefault();
      }
    } catch (err) {}
  });

  const routeSelect = document.getElementById('supervision-route-select');
  const branchSelect = document.getElementById('supervision-branch-select');
  const addBranchBtn = document.getElementById('supervision-add-branch-btn');
  const employeeSelect = document.getElementById('supervision-employee-select');
  const addEmployeeBtn = document.getElementById('supervision-add-employee-btn');
  const branchListBody = document.getElementById('supervision-assigned-branches-list');
  const collaboratorListBody = document.getElementById('supervision-assigned-collaborators-list');
  const autoDeptListBody = document.getElementById('supervision-auto-dept-list');
  const currentSupervisorEl = document.getElementById('current-supervisor');
  const collabSearch = document.getElementById('collab-search');
  const collabSelect = document.getElementById('collab-select');
  const collabAddBtn = document.getElementById('collab-add-btn');
  const collabHeredaKpis = document.getElementById('collab-hereda-kpis');
  const collabHeredaCalif = document.getElementById('collab-hereda-calif');
  const collabStatus = document.getElementById('collab-search-status');
  let searchTimer = null;

  function esc(str) {
    return String(str || '').replace(/[&<>"']/g, function(s) {
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[s];
    });
  }
  async function fetchJson(url, options) {
    const resp = await fetch(url, options);
    const data = await resp.json();
    if (!data.ok) throw new Error(data.error || 'Error en la operación');
    return data;
  }
  function setRouteControlsEnabled(enabled) {
    branchSelect.disabled = !enabled;
    addBranchBtn.disabled = !enabled;
    employeeSelect.disabled = !enabled;
    addEmployeeBtn.disabled = !enabled;
    collabSearch.disabled = !enabled;
    collabSelect.disabled = !enabled;
    collabAddBtn.disabled = !enabled;
    collabHeredaKpis.disabled = !enabled;
    collabHeredaCalif.disabled = !enabled;
  }

  async function loadRoutes() {
    try {
      const data = await fetchJson('/supervision/routes');
      routeSelect.innerHTML = '<option value="">Selecciona una ruta...</option>';
      (data.routes || []).forEach(function(rt) {
        const opt = document.createElement('option');
        opt.value = rt.id;
        opt.textContent = rt.nombre || ('Ruta ' + rt.id);
        routeSelect.appendChild(opt);
      });
    } catch (e) { console.error('Error al cargar rutas:', e); }
  }
  async function loadBranches() {
    try {
      // Compatibilidad: algunas versiones exponen /branches y otras /sucursales-json.
      let data;
      try { data = await fetchJson('/branches'); }
      catch (_) { data = await fetchJson('/sucursales-json'); }
      branchSelect.innerHTML = '<option value="">Selecciona una sucursal...</option>';
      (data.branches || []).forEach(function(br) {
        const opt = document.createElement('option');
        opt.value = br.id;
        opt.textContent = br.nombre || '';
        branchSelect.appendChild(opt);
      });
    } catch (e) { console.error('Error al cargar sucursales para rutas:', e); }
  }
  async function loadEligibleEmployees() {
    try {
      const data = await fetchJson('/supervision/eligible-employees');
      employeeSelect.innerHTML = '<option value="">Selecciona un supervisor...</option>';
      (data.employees || []).forEach(function(emp) {
        const opt = document.createElement('option');
        opt.value = emp.id;
        opt.textContent = emp.nombre + ' (' + (emp.puesto || '') + ')';
        employeeSelect.appendChild(opt);
      });
    } catch (e) { console.error('Error al cargar supervisores elegibles:', e); }
  }

  async function loadCollaboratorOptions() {
    const q = collabSearch.value.trim();
    collabSelect.innerHTML = '<option value="">Buscando...</option>';
    collabStatus.textContent = '';
    try {
      const rutaId = routeSelect.value || '';
      const data = await fetchJson('/api/supervision/empleados-disponibles?solo_operaciones=1&ruta_id=' + encodeURIComponent(rutaId) + '&q=' + encodeURIComponent(q));
      const empleados = data.empleados || [];
      collabSelect.innerHTML = '<option value="">Selecciona un empleado...</option>';
      empleados.forEach(function(emp) {
        const opt = document.createElement('option');
        opt.value = emp.id;
        opt.textContent = (emp.incidencia_id ? emp.incidencia_id + ' - ' : '') + emp.nombre + ' | ' + (emp.puesto || 'Sin puesto') + ' | ' + (emp.departamento || 'Sin depto');
        collabSelect.appendChild(opt);
      });
      collabStatus.textContent = empleados.length ? (empleados.length + ' empleado(s) disponibles.') : 'No se encontraron empleados disponibles de Operaciones Sucursales ni detectados por sucursal/departamento de esta ruta.';
    } catch (e) {
      console.error('Error al buscar colaboradores:', e);
      collabSelect.innerHTML = '<option value="">No se pudo buscar</option>';
      collabStatus.textContent = 'No se pudo cargar la lista de colaboradores.';
    }
  }

  async function loadAssignedForRoute(rutaId) {
    branchListBody.innerHTML = '';
    collaboratorListBody.innerHTML = '';
    if (autoDeptListBody) autoDeptListBody.innerHTML = '';
    currentSupervisorEl.innerHTML = '<span class="text-muted">Sin supervisor asignado</span>';
    if (!rutaId) { setRouteControlsEnabled(false); return; }
    setRouteControlsEnabled(true);
    try {
      const data = await fetchJson('/api/supervision/rutas/' + rutaId);
      (data.sucursales || []).forEach(function(br) {
        const tr = document.createElement('tr');
        tr.innerHTML = '<td>' + esc(br.nombre || '') + '</td>' +
          '<td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger" data-branch-id="' + br.id + '">Quitar</button></td>';
        branchListBody.appendChild(tr);
      });
      if (!branchListBody.children.length) {
        branchListBody.innerHTML = '<tr><td colspan="2" class="text-muted">Sin sucursales asignadas</td></tr>';
      }
      if (data.supervisor) {
        currentSupervisorEl.innerHTML = '<strong>' + esc(data.supervisor.nombre) + '</strong><br><span class="text-muted">' + esc(data.supervisor.puesto || '') + '</span>';
      }
      (data.colaboradores || []).forEach(function(emp) {
        const tr = document.createElement('tr');
        tr.innerHTML = '<td>' + esc(emp.nombre || '') + '</td>' +
          '<td>' + esc(emp.puesto || '') + '</td>' +
          '<td>' + esc(emp.departamento || '') + '</td>' +
          '<td class="text-center"><input type="checkbox" data-collab-field="hereda_kpis" data-emp-id="' + emp.id + '" ' + (Number(emp.hereda_kpis) === 1 ? 'checked' : '') + '></td>' +
          '<td class="text-center"><input type="checkbox" data-collab-field="hereda_calificacion_supervisor" data-emp-id="' + emp.id + '" ' + (Number(emp.hereda_calificacion_supervisor) === 1 ? 'checked' : '') + '></td>' +
          '<td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger" data-collab-remove="' + emp.id + '">Quitar</button></td>';
        collaboratorListBody.appendChild(tr);
      });
      if (!collaboratorListBody.children.length) {
        collaboratorListBody.innerHTML = '<tr><td colspan="6" class="text-muted">Sin colaboradores asignados</td></tr>';
      }
      if (autoDeptListBody) {
        autoDeptListBody.innerHTML = '';
        (data.detectados_departamento || []).forEach(function(emp) {
          const tr = document.createElement('tr');
          tr.innerHTML = '<td>' + esc((emp.incidencia_id ? emp.incidencia_id + ' - ' : '') + (emp.nombre || '')) + '</td>' +
            '<td>' + esc(emp.puesto || '') + '</td>' +
            '<td>' + esc(emp.departamento || '') + '</td>' +
            '<td>' + esc(emp.sucursal || '') + '</td>';
          autoDeptListBody.appendChild(tr);
        });
        if (!autoDeptListBody.children.length) {
          autoDeptListBody.innerHTML = '<tr><td colspan="4" class="text-muted">No hay empleados pendientes detectados por sucursal/departamento SUPERVISION en esta ruta</td></tr>';
        }
      }
      await loadCollaboratorOptions();
    } catch (e) {
      console.error('Error al cargar asignaciones para la ruta:', e);
      alert(e.message || 'No se pudo cargar la ruta');
    }
  }

  async function loadSummary() {
    const summaryDiv = document.getElementById('supervision-summary');
    summaryDiv.innerHTML = '<div class="text-muted">Cargando rutas...</div>';
    try {
      const dataRoutes = await fetchJson('/api/supervision/rutas');
      const routes = dataRoutes.rutas || dataRoutes.routes || [];
      if (!routes.length) {
        summaryDiv.innerHTML = '<p class="text-muted">No hay rutas definidas.</p>';
        return;
      }
      const table = document.createElement('table');
      table.className = 'table table-sm table-bordered align-middle';
      const thead = document.createElement('thead');
      thead.innerHTML = '<tr><th>Ruta</th><th>Supervisor</th><th># Sucursales</th><th># Colaboradores</th><th>Acciones</th></tr>';
      const tbody = document.createElement('tbody');
      for (const rt of routes) {
        let detail = { supervisor: null, sucursales: [], colaboradores: [] };
        try { detail = await fetchJson('/api/supervision/rutas/' + rt.id); } catch (_) {}
        const tr = document.createElement('tr');
        const supText = detail.supervisor ? esc(detail.supervisor.nombre) : '<span class="text-muted">Sin supervisor asignado</span>';
        tr.innerHTML = '<td>' + esc(rt.nombre || rt.id) + '</td>' +
          '<td>' + supText + '</td>' +
          '<td>' + ((detail.sucursales || []).length) + '</td>' +
          '<td>' + ((detail.colaboradores || []).length) + '</td>' +
          '<td><button type="button" class="btn btn-sm btn-primary" data-route-id="' + rt.id + '">Editar</button></td>';
        tbody.appendChild(tr);
      }
      table.appendChild(thead);
      table.appendChild(tbody);
      summaryDiv.innerHTML = '';
      summaryDiv.appendChild(table);
    } catch (e) {
      console.error('Error al cargar resumen de rutas:', e);
      summaryDiv.innerHTML = '<p class="text-danger">Error al cargar resumen de rutas.</p>';
    }
  }

  routeSelect.addEventListener('change', function() { loadAssignedForRoute(routeSelect.value); });

  addBranchBtn.addEventListener('click', async function() {
    const rutaId = routeSelect.value;
    const branchId = branchSelect.value;
    if (!rutaId || !branchId) return;
    addBranchBtn.disabled = true;
    try {
      await fetchJson('/supervision/routes/' + rutaId + '/branches', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ branchId: branchId })
      });
      branchSelect.value = '';
    } catch (e) { alert(e.message || 'No se pudo asignar sucursal'); }
    addBranchBtn.disabled = false;
    await loadAssignedForRoute(rutaId);
    await loadSummary();
  });

  addEmployeeBtn.addEventListener('click', async function() {
    const rutaId = routeSelect.value;
    const empId = employeeSelect.value;
    if (!rutaId || !empId) return;
    addEmployeeBtn.disabled = true;
    try {
      await fetchJson('/supervision/routes/' + rutaId + '/employees', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ employeeId: empId })
      });
      employeeSelect.value = '';
    } catch (e) { alert(e.message || 'No se pudo asignar supervisor'); }
    addEmployeeBtn.disabled = false;
    await loadAssignedForRoute(rutaId);
    await loadSummary();
  });

  collabSearch.addEventListener('input', function() {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(loadCollaboratorOptions, 350);
  });

  collabAddBtn.addEventListener('click', async function() {
    const rutaId = routeSelect.value;
    const empId = collabSelect.value;
    if (!rutaId || !empId) return;
    collabAddBtn.disabled = true;
    try {
      await fetchJson('/api/supervision/rutas/' + rutaId + '/colaboradores', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          empleado_id: empId,
          hereda_kpis: collabHeredaKpis.checked ? 1 : 0,
          hereda_calificacion_supervisor: collabHeredaCalif.checked ? 1 : 0
        })
      });
      collabSearch.value = '';
      collabSelect.innerHTML = '<option value="">Busca y selecciona un empleado...</option>';
    } catch (e) { alert(e.message || 'No se pudo agregar colaborador'); }
    collabAddBtn.disabled = false;
    await loadAssignedForRoute(rutaId);
    await loadSummary();
  });

  branchListBody.addEventListener('click', async function(ev) {
    const btn = ev.target.closest('button[data-branch-id]');
    if (!btn) return;
    const rutaId = routeSelect.value;
    const branchId = btn.getAttribute('data-branch-id');
    if (!window.confirm('¿Quitar esta sucursal de la ruta?')) return;
    btn.disabled = true;
    try { await fetchJson('/supervision/routes/' + rutaId + '/branches/' + branchId, { method: 'DELETE' }); }
    catch (e) { alert(e.message || 'No se pudo quitar sucursal'); }
    await loadAssignedForRoute(rutaId);
    await loadSummary();
  });

  collaboratorListBody.addEventListener('click', async function(ev) {
    const btn = ev.target.closest('button[data-collab-remove]');
    if (!btn) return;
    const rutaId = routeSelect.value;
    const empId = btn.getAttribute('data-collab-remove');
    if (!window.confirm('¿Quitar este colaborador de la ruta?')) return;
    btn.disabled = true;
    try { await fetchJson('/api/supervision/rutas/' + rutaId + '/colaboradores/' + empId, { method: 'DELETE' }); }
    catch (e) { alert(e.message || 'No se pudo quitar colaborador'); }
    await loadAssignedForRoute(rutaId);
    await loadSummary();
  });

  collaboratorListBody.addEventListener('change', async function(ev) {
    const input = ev.target.closest('input[data-collab-field]');
    if (!input) return;
    const rutaId = routeSelect.value;
    const empId = input.getAttribute('data-emp-id');
    const row = input.closest('tr');
    const hk = row.querySelector('input[data-collab-field="hereda_kpis"]').checked ? 1 : 0;
    const hc = row.querySelector('input[data-collab-field="hereda_calificacion_supervisor"]').checked ? 1 : 0;
    try {
      await fetchJson('/api/supervision/rutas/' + rutaId + '/colaboradores/' + empId, {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ hereda_kpis: hk, hereda_calificacion_supervisor: hc, activo: 1 })
      });
    } catch (e) {
      alert(e.message || 'No se pudo actualizar la herencia');
      await loadAssignedForRoute(rutaId);
    }
  });

  document.getElementById('supervision-summary').addEventListener('click', function(ev) {
    const btn = ev.target.closest('button[data-route-id]');
    if (!btn) return;
    const rutaId = btn.getAttribute('data-route-id');
    routeSelect.value = rutaId;
    const managementContainer = document.getElementById('supervision-management-container');
    if (managementContainer) managementContainer.style.display = '';
    loadAssignedForRoute(rutaId);
  });

  setRouteControlsEnabled(false);
  loadRoutes();
  loadBranches();
  loadEligibleEmployees();
  loadSummary();
});
</script>

