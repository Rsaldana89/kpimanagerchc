<%- include('partials/header') %>

<div class="mb-4 d-flex justify-content-between align-items-center flex-wrap">
  <h2 class="mb-3"><%= title %></h2>
  <% if (isManager && !supervisorList) { %>
    <a href="/supervision/view" class="btn btn-outline-secondary">← Cambiar supervisor</a>
  <% } %>
</div>

<% if (supervisorList) { %>
  <p class="mb-3">Seleccione un supervisor para ver su ruta:</p>
  <table class="table table-bordered table-hover">
    <thead class="table-light">
      <tr>
        <th>#</th>
        <th>Supervisor</th>
        <th>Ruta</th>
        <th>Sucursal virtual</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% supervisorList.forEach((sup, idx) => { %>
        <tr>
          <td><%= idx + 1 %></td>
          <td><%= sup.empleado_nombre %></td>
          <td><%= sup.ruta_id %></td>
          <td><%= sup.sucursal_nombre %></td>
          <td><a href="/supervision/view/<%= sup.empleado_id %>" class="btn btn-sm btn-primary">Ver ruta</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } else { %>
  <!-- Mostrar detalles de una ruta específica -->
  <% if (supervisor) { %>
    <div class="mb-4">
      <h4 class="mb-2">Supervisor: <strong><%= supervisor.supervisor_nombre %></strong></h4>
      <p class="mb-1"><strong>Ruta:</strong> <%= supervisor.ruta_id %></p>
      <p><strong>Sucursal virtual:</strong> <%= supervisor.sucursal_nombre %></p>
    </div>

    <!-- Colaboradores en la sucursal virtual (supervisores y auxiliares) -->
    <div class="mb-4">
      <h5>Equipo de supervisión en <%= supervisor.sucursal_nombre %></h5>
      <% if (!virtualEmployees || virtualEmployees.length === 0) { %>
        <p class="text-muted">No hay colaboradores asignados a esta sucursal virtual.</p>
      <% } else { %>
        <table class="table table-sm table-bordered align-middle">
          <thead class="table-light">
            <tr>
              <th>#</th>
              <th>Empleado</th>
              <th>Puesto</th>
            </tr>
          </thead>
          <tbody>
            <% virtualEmployees.forEach((emp, idx) => { %>
              <tr>
                <td><%= idx + 1 %></td>
                <td><%= emp.nombre %></td>
                <td><%= emp.puesto_nombre %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <!-- Listado de sucursales reales -->
    <div>
      <h5>Sucursales de la ruta <%= supervisor.ruta_id %></h5>
      <% if (!branches || branches.length === 0) { %>
        <p class="text-muted">Esta ruta no tiene sucursales asignadas.</p>
      <% } else { %>
        <% branches.forEach((br, idx) => { %>
          <div class="mb-4">
            <h6><%= br.sucursal_nombre %></h6>
            <% const emps = branchEmployees && branchEmployees[br.sucursal_id] ? branchEmployees[br.sucursal_id] : []; %>
            <% if (!emps || emps.length === 0) { %>
              <p class="text-muted">No hay colaboradores en esta sucursal.</p>
            <% } else { %>
              <table class="table table-sm table-bordered align-middle">
                <thead class="table-light">
                  <tr>
                    <th>#</th>
                    <th>Empleado</th>
                    <th>Puesto</th>
                  </tr>
                </thead>
                <tbody>
                  <% emps.forEach((emp, j) => { %>
                    <tr>
                      <td><%= j + 1 %></td>
                      <td><%= emp.nombre %></td>
                      <td><%= emp.puesto_nombre %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            <% } %>
          </div>
        <% }) %>
      <% } %>
    </div>
  <% } %>
<% } %>

<%- include('partials/footer') %>