<%- include('partials/header') %>
<h2 class="mb-3">Envío masivo de KPIs</h2>

<h4>Configuración de envío masivo</h4>
<p class="text-muted mb-2">El envío automático (cuando está activado) envía siempre <strong>el mes anterior</strong> y comienza a partir del día configurado. Las sucursales quedan excluidas por ahora.</p>
<form method="post" action="/admin/mass-email/config" class="mb-4">
  <div class="row g-3">
    <div class="col-sm-3 d-flex align-items-center">
      <div class="form-check mt-4">
        <input class="form-check-input" type="checkbox" id="enabled" name="enabled" value="1" <%= config.enabled ? 'checked' : '' %>>
        <label class="form-check-label" for="enabled">Activar envío automático</label>
      </div>
    </div>
    <div class="col-sm-3">
      <label for="start_day" class="form-label">Día de envío (1‑31)</label>
      <input type="number" class="form-control" id="start_day" name="start_day" min="1" max="31" value="<%= config.start_day %>" required>
    </div>
    <div class="col-sm-3">
      <label for="send_time" class="form-label">Hora de envío (HH:MM)</label>
      <input type="text" class="form-control" id="send_time" name="send_time" value="<%= config.send_time %>" placeholder="20:00" pattern="\d{1,2}:\d{2}" required>
    </div>
    <div class="col-sm-3">
      <label for="batch_limit" class="form-label">Límite diario de correos</label>
      <input type="number" class="form-control" id="batch_limit" name="batch_limit" min="1" value="<%= config.batch_limit %>" required>
    </div>
    <div class="col-sm-12">
      <div class="form-check mt-4">
        <input class="form-check-input" type="checkbox" id="resend_sent" name="resend_sent" value="1" <%= config.resend_sent ? 'checked' : '' %>>
        <label class="form-check-label" for="resend_sent">Cuando no queden pendientes, reenviar (por lote) a quienes ya recibieron el correo</label>
      </div>
    </div>
  </div>
  <div class="mt-3">
    <input type="hidden" name="anio" value="<%= selectedYear %>">
    <input type="hidden" name="mes" value="<%= selectedMonth %>">
    <button type="submit" class="btn btn-primary">Guardar configuración</button>
  </div>
</form>

<div class="card mb-4">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center">
      <h5 class="card-title mb-0">Progreso de envíos</h5>
      <small class="text-muted" id="progress-updated">...</small>
    </div>
    <div id="progress-area" class="mt-3">
      <% if (recentRuns && recentRuns.length) { %>
        <% const r0 = recentRuns[0]; %>
        <% const pct0 = r0.total_targets ? Math.round((Number(r0.sent_count || 0) / Number(r0.total_targets)) * 100) : 0; %>
        <div class="mb-2">
          <strong>Última ejecución:</strong>
          <span class="ms-2"><%= String(r0.period_month).padStart(2,'0') %>/<%= r0.period_year %></span>
          <span class="ms-2 badge <%= r0.is_running ? 'bg-warning text-dark' : 'bg-success' %>">
            <%= r0.is_running ? 'En curso' : 'Finalizada' %>
          </span>
          <% if (r0.last_message) { %>
            <div class="text-muted small mt-1"><%= r0.last_message %></div>
          <% } %>
        </div>
        <div class="progress" style="height: 18px;">
          <div class="progress-bar" role="progressbar" style="width: <%= pct0 %>%" aria-valuenow="<%= pct0 %>" aria-valuemin="0" aria-valuemax="100"><%= pct0 %>%</div>
        </div>
        <div class="small text-muted mt-2">
          Enviados: <strong id="p-sent"><%= r0.sent_count || 0 %></strong> / <strong id="p-total"><%= r0.total_targets || 0 %></strong>
          &nbsp;|&nbsp; Errores: <strong id="p-err"><%= r0.error_count || 0 %></strong>
        </div>
      <% } else { %>
        <div class="text-muted">Aún no hay ejecuciones registradas.</div>
      <% } %>
    </div>

    <% if (recentRuns && recentRuns.length > 1) { %>
      <hr>
      <div class="small text-muted mb-2">Historial reciente</div>
      <div class="table-responsive">
        <table class="table table-sm">
          <thead>
            <tr>
              <th>Periodo</th>
              <th>Inicio</th>
              <th>Estado</th>
              <th>Enviados</th>
              <th>Errores</th>
            </tr>
          </thead>
          <tbody>
            <% recentRuns.slice(0, 10).forEach(r => { %>
              <tr>
                <td><%= String(r.period_month).padStart(2,'0') %>/<%= r.period_year %></td>
                <td><%= r.started_at ? new Date(r.started_at).toLocaleString('es-MX') : '' %></td>
                <td>
                  <span class="badge <%= r.is_running ? 'bg-warning text-dark' : 'bg-secondary' %>"><%= r.is_running ? 'En curso' : 'Finalizada' %></span>
                </td>
                <td><%= r.sent_count || 0 %>/<%= r.total_targets || 0 %></td>
                <td><%= r.error_count || 0 %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<script>
  async function refreshProgress() {
    try {
      const res = await fetch('/admin/mass-email/progress', { credentials: 'same-origin' });
      const data = await res.json();
      if (!data || !data.run) {
        document.getElementById('progress-updated').innerText = 'Sin datos';
        return;
      }
      const run = data.run;
      const pct = data.percent || 0;
      const bar = document.querySelector('#progress-area .progress-bar');
      if (bar) {
        bar.style.width = pct + '%';
        bar.setAttribute('aria-valuenow', String(pct));
        bar.textContent = pct + '%';
      }
      const pSent = document.getElementById('p-sent');
      const pTotal = document.getElementById('p-total');
      const pErr = document.getElementById('p-err');
      if (pSent) pSent.textContent = run.sent_count || 0;
      if (pTotal) pTotal.textContent = run.total_targets || 0;
      if (pErr) pErr.textContent = run.error_count || 0;
      document.getElementById('progress-updated').innerText = 'Actualizado: ' + new Date().toLocaleTimeString('es-MX');
    } catch (e) {
      // No interrumpir la página
    }
  }
  // Refrescar cada 10s (ligero). Si no está habilitado o no hay cron, igual se verá el último estado.
  setInterval(refreshProgress, 10000);
</script>

<h4 class="mt-4">Enviar resultados de KPIs</h4>
<form method="get" action="/admin/mass-email" class="row row-cols-lg-auto g-3 align-items-end mb-3">
  <div class="col">
    <label for="anio" class="form-label">Año</label>
    <select name="anio" id="anio" class="form-select">
      <% for (let y = defaultYear - 2; y <= defaultYear + 1; y++) { %>
        <option value="<%= y %>" <%= selectedYear === y ? 'selected' : '' %>><%= y %></option>
      <% } %>
    </select>
  </div>
  <div class="col">
    <label for="mes" class="form-label">Mes</label>
    <% const monthNames = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre']; %>
    <select name="mes" id="mes" class="form-select">
      <% for (let i = 1; i <= 12; i++) { %>
        <option value="<%= i %>" <%= selectedMonth === i ? 'selected' : '' %>><%= monthNames[i - 1] %></option>
      <% } %>
    </select>
  </div>
  <div class="col">
    <button type="submit" class="btn btn-secondary">Actualizar periodo</button>
  </div>
</form>

<p>Total de empleados (sin sucursales ni BAJA): <strong><%= employees.length %></strong>.  Completos: <strong><%= completedCount %></strong>.  Porcentaje completado: <strong><%= completionPercent %>%</strong>.</p>

<!-- Opción global para reenviar a quienes ya recibieron el correo manualmente -->
<div class="form-check mb-3">
  <input class="form-check-input" type="checkbox" id="includeSentGlobal">
  <label class="form-check-label" for="includeSentGlobal">
    Incluir a quienes ya recibieron el correo este periodo (reenvío manual)
  </label>
</div>
<script>
  (function() {
    const toggle = document.getElementById('includeSentGlobal');
    function updateForms() {
      document.querySelectorAll('form.mass-send-form').forEach(form => {
        const hidden = form.querySelector('input[name="includeSent"]');
        if (toggle.checked) {
          if (!hidden) {
            const inp = document.createElement('input');
            inp.type = 'hidden';
            inp.name = 'includeSent';
            inp.value = '1';
            form.appendChild(inp);
          }
        } else {
          if (hidden) hidden.remove();
        }
      });
    }
    if (toggle) toggle.addEventListener('change', updateForms);
  })();
</script>

<div class="mb-4">
  <form method="post" action="/admin/mass-email/send" class="d-inline mass-send-form">
    <input type="hidden" name="anio" value="<%= selectedYear %>">
    <input type="hidden" name="mes" value="<%= selectedMonth %>">
    <input type="hidden" name="sendAll" value="1">
    <button type="submit" class="btn btn-success">Enviar a todos</button>
  </form>
</div>

<h5>Envío por departamento</h5>
<div class="table-responsive">
  <table class="table table-bordered table-sm">
    <thead class="table-light">
      <tr>
        <th>Departamento</th>
        <th>Total empleados</th>
        <th>Completos</th>
        <th>% completado</th>
        <th>Acción</th>
      </tr>
    </thead>
    <tbody>
      <% departmentsSummary.forEach(dep => { %>
        <tr>
          <td><%= dep.nombre %></td>
          <td><%= dep.total %></td>
          <td><%= dep.completed %></td>
          <td><%= dep.percent %>%</td>
          <td>
            <form method="post" action="/admin/mass-email/send" class="d-inline mass-send-form">
              <input type="hidden" name="anio" value="<%= selectedYear %>">
              <input type="hidden" name="mes" value="<%= selectedMonth %>">
              <input type="hidden" name="departmentIds[]" value="<%= dep.id %>">
              <button type="submit" class="btn btn-sm btn-outline-primary">Enviar</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<h5>Envío individual</h5>
<div class="table-responsive">
  <table class="table table-bordered table-sm">
    <thead class="table-light">
      <tr>
        <th>No. Empleado</th>
        <th>Nombre</th>
        <th>Departamento</th>
        <th>Completado</th>
        <th>Acción</th>
      </tr>
    </thead>
    <tbody>
      <% employees.forEach(emp => { %>
        <tr class="<%= emp.completed ? '' : 'table-warning' %>">
          <td><%= emp.incidencia_id || emp.id %></td>
          <td><%= emp.nombre %></td>
          <td><%= emp.departamento_nombre || '' %></td>
          <td><%= emp.completed ? 'Sí' : 'No' %></td>
          <td>
            <form method="post" action="/admin/mass-email/send" class="d-inline mass-send-form">
              <input type="hidden" name="anio" value="<%= selectedYear %>">
              <input type="hidden" name="mes" value="<%= selectedMonth %>">
              <input type="hidden" name="employeeIds[]" value="<%= emp.id %>">
              <button type="submit" class="btn btn-sm btn-outline-secondary">Enviar</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>