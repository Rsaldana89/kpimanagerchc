<%- include('partials/header') %>
<% const _showBajas = (typeof showBajas !== 'undefined' ? showBajas : false); %>
<% const fmtDate = (d) => { if (!d) return ''; const dd = new Date(d); if (isNaN(dd.getTime())) return ''; return dd.toLocaleDateString('es-MX'); }; %>
<h2 class="mb-4">Mis KPIs
  <% if (typeof currentEmpNo !== 'undefined' && String(currentEmpNo || '').trim() !== '') { %>
    <span class="badge bg-light text-dark border ms-2">No. <%= String(currentEmpNo).padStart(5,'0') %></span>
  <% } %>
  <% if (typeof currentEmpName !== 'undefined' && String(currentEmpName || '').trim() !== '') { %>
    <span class="ms-2"><%= currentEmpName %></span>
  <% } %>
  <% if (typeof currentRouteName !== 'undefined' && currentRouteName) { %>
    <span class="badge bg-info text-dark ms-2">Ruta: <%= currentRouteName %></span>
  <% } %>
  <% if (typeof currentBranchName !== 'undefined' && currentBranchName) { %>
    <span class="badge bg-secondary text-light ms-2">Sucursal: <%= currentBranchName %></span>
  <% } %>
  &nbsp;—&nbsp;
  <% const monthNames = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre']; %>
  <%= monthNames[selectedMonth - 1] %> <%= selectedYear %>
  <small class="text-muted">(periodo mensual)</small>
</h2>
<p>
  En esta tabla puedes capturar tus resultados mensuales para cada KPI asignado. Selecciona un periodo y guarda tu resultado
  para ese mes. Si el KPI es <strong>numérico</strong>, <strong>porcentual</strong> o <strong>por criterio</strong>, ingresa tu resultado.
  El semáforo de color se calcula automáticamente para valores numéricos y porcentuales.
</p>

<!-- Si no se especifica anio/mes en la URL, redirigir al periodo por defecto calculado en el cliente.
     Esto permite que el periodo se ajuste al cambiar la fecha del equipo y que la URL refleje
     el periodo seleccionado.  El servidor también aplica esta lógica como respaldo. -->
<script>
  (function() {
    try {
      const url = new URL(window.location.href);
      const hasYear = url.searchParams.has('anio');
      const hasMonth = url.searchParams.has('mes');
      if (!hasYear && !hasMonth) {
        const now = new Date();
        let y = now.getFullYear();
        let m = now.getMonth() + 1;
        // Hasta el día 25 inclusive se utiliza el mes anterior.  Esto mantiene
        // el mismo comportamiento que en el servidor (ver getDefaultPeriod en
        // routes/dashboard.js).  Anteriormente se usaba <= 10 pero el negocio
        // cambió a 25 para que el mes anterior permanezca abierto más tiempo.
        if (now.getDate() <= 25) {
          m -= 1;
          if (m < 1) { m = 12; y -= 1; }
        }
        url.searchParams.set('anio', y);
        url.searchParams.set('mes', m);
        window.location.replace(url.pathname + '?' + url.searchParams.toString() + (url.hash || ''));
      }
    } catch (e) {
      console.error('Redirección de periodo por defecto falló:', e);
    }
  })();
</script>

<!-- Formulario para seleccionar periodo -->
<form method="get" action="/dashboard" class="row row-cols-lg-auto g-3 align-items-center mb-3">
  <div class="col-12">
    <label for="anio" class="form-label mb-0">Año:</label>
    <select name="anio" id="anio" class="form-select form-select-sm">
      <% const currentYearValue = new Date().getFullYear();
         for (let y = currentYearValue - 2; y <= currentYearValue + 1; y++) { %>
        <option value="<%= y %>" <%= selectedYear === y ? 'selected' : '' %>><%= y %></option>
      <% } %>
    </select>
  </div>
  <div class="col-12">
    <label for="mes" class="form-label mb-0">Mes:</label>
    <select name="mes" id="mes" class="form-select form-select-sm">
      <% monthNames.forEach((mn, idx) => { const m = idx + 1; %>
        <option value="<%= m %>" <%= selectedMonth === m ? 'selected' : '' %>><%= mn %></option>
      <% }); %>
    </select>
  </div>
  <div class="col-12">
    <button type="submit" class="btn btn-sm btn-primary">Cambiar periodo</button>
  </div>
  <div class="col-12">
    <div class="form-check">
      <input class="form-check-input" type="checkbox" name="showBajas" value="1" id="showBajas" <%= _showBajas ? 'checked' : '' %>>
      <label class="form-check-label" for="showBajas">Mostrar personal en BAJA</label>
    </div>
  </div>

</form>

<div class="d-flex flex-wrap gap-2 mb-2">
  <!-- Exportaciones -->
  <div class="btn-group">
    <button type="button" class="btn btn-sm btn-outline-success dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
      Exportar mis KPIs
    </button>
    <ul class="dropdown-menu">
      <li>
        <a class="dropdown-item" href="/dashboard/export/self?anio=<%= selectedYear %>&mes=<%= selectedMonth %>&mode=period">
          Periodo (mes)
        </a>
      </li>
      <li>
        <a class="dropdown-item" href="/dashboard/export/self?anio=<%= selectedYear %>&mes=<%= selectedMonth %>&mode=annual">
          Historial anual
        </a>
      </li>
    </ul>
  </div>

  <div class="btn-group">
    <button type="button" class="btn btn-sm btn-outline-success dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
      Exportar mi equipo
    </button>
    <ul class="dropdown-menu">
      <li>
        <a class="dropdown-item" href="/dashboard/export/team?anio=<%= selectedYear %>&mes=<%= selectedMonth %>&mode=period&showBajas=<%= _showBajas ? '1' : '0' %>">
          Exportar todos (mes)
        </a>
      </li>
      <li>
        <a class="dropdown-item" href="/dashboard/export/team?anio=<%= selectedYear %>&mes=<%= selectedMonth %>&mode=annual&showBajas=<%= _showBajas ? '1' : '0' %>">
          Exportar todos (anual)
        </a>
      </li>
      <% if (Array.isArray(subordinatesWithChildren) && subordinatesWithChildren.length) { %>
        <li><hr class="dropdown-divider"></li>
        <% subordinatesWithChildren.forEach(function(sub) { %>
          <li>
            <a class="dropdown-item" href="/dashboard/export/subteam/<%= sub.id %>?anio=<%= selectedYear %>&mes=<%= selectedMonth %>&mode=period&showBajas=<%= _showBajas ? '1' : '0' %>">
              Equipo de <%= sub.nombre %> (mes)
            </a>
          </li>
          <li>
            <a class="dropdown-item" href="/dashboard/export/subteam/<%= sub.id %>?anio=<%= selectedYear %>&mes=<%= selectedMonth %>&mode=annual&showBajas=<%= _showBajas ? '1' : '0' %>">
              Equipo de <%= sub.nombre %> (anual)
            </a>
          </li>
        <% }); %>
      <% } %>
    </ul>
  </div>

  <!-- Envío por correo -->
  <div class="btn-group">
    <button type="button" class="btn btn-sm btn-outline-info dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
      Enviar KPIs por correo
    </button>
    <ul class="dropdown-menu">
      <li><a class="dropdown-item" href="#" id="send-self">Enviar mis KPIs</a></li>
      <% if (typeof hasDirectSubordinates !== 'undefined' && hasDirectSubordinates) { %>
      <li><a class="dropdown-item" href="#" id="send-direct">Enviar a mis subordinados directos</a></li>
      <% } %>
      <% if (typeof hasAnySubordinates !== 'undefined' && hasAnySubordinates) { %>
      <li><a class="dropdown-item" href="#" id="send-team">Enviar a todo mi equipo</a></li>
      <% } %>
    </ul>
  </div>
</div>

<div class="table-responsive">

  <table class="table table-bordered align-middle">
    <thead class="table-light">
      <tr>
        <th>KPI</th>
        <th>Objetivo</th>
        <th>Unidad</th>
        <th>Criterios de calificación</th>
        <!-- Cambiamos "Resultado" por "Calificación" para mayor claridad -->
        <th class="text-center">Calificación</th>
        <!-- Nuevo: columna de peso (%) asignado a cada KPI -->
        <th class="text-center">Peso&nbsp;(%)</th>
        <!-- Nuevo: puntaje ponderado del KPI -->
        <th class="text-center">Puntaje&nbsp;ponderado</th>
        <th>Comentarios</th>
      </tr>
    </thead>
    <tbody>
      <%
        // Llevar la suma total de los puntajes ponderados de este periodo.
        let totalWeightedScore = 0;
        kpis.forEach(kpi => {
          const res = (resultados[kpi.id] && resultados[kpi.id][selectedMonth]) || {};
          let colorClass = '';
          if (res.color === 'rojo') colorClass = 'bg-danger text-light';
          if (res.color === 'amarillo') colorClass = 'bg-warning';
          if (res.color === 'verde') colorClass = 'bg-success text-light';
          const isLocked = (res.visto_bueno === 1);
          const puntaje = res.color === 'rojo' ? 40 : (res.color === 'amarillo' ? 70 : (res.color === 'verde' ? 100 : ''));
          const estado = isLocked ? 'APROBADO' : (res.revision_por ? 'EN REVISIÓN' : 'ABIERTO');
          const estadoClass = (estado === 'APROBADO') ? 'bg-success text-light' : (estado === 'EN REVISIÓN' ? 'bg-warning text-dark' : 'bg-secondary text-light');
          // Calcular puntaje ponderado.  Si puntaje está vacío (''), dejamos vacío.
          let weightedScore = '';
          const pesoVal = (kpi.peso !== null && kpi.peso !== undefined) ? Number(kpi.peso) : 0;
          if (puntaje !== '' && pesoVal) {
            const ws = (Number(puntaje) * (pesoVal / 100));
            weightedScore = ws.toFixed(2).replace(/\.0+$/,'').replace(/(\.\d*[1-9])0+$/,'$1');
            totalWeightedScore += ws;
          }
      %>
      <tr
        data-kpi-row
        data-empleado-id="<%= user.id %>"
        data-kpi-id="<%= kpi.id %>"
        data-can-approve="<%= canApproveSelf ? '1' : '0' %>"
        data-score-type="<%= (kpi.score_type || '').toUpperCase() %>"
        data-direction="<%= (kpi.direction || 'HIGHER_BETTER').toUpperCase() %>"
        data-threshold-yellow="<%= (kpi.threshold_yellow !== null && kpi.threshold_yellow !== undefined) ? kpi.threshold_yellow : '' %>"
        data-threshold-green="<%= (kpi.threshold_green !== null && kpi.threshold_green !== undefined) ? kpi.threshold_green : '' %>"
        data-criterion-red="<%= kpi.criterion_red || '' %>"
        data-criterion-yellow="<%= kpi.criterion_yellow || '' %>"
        data-criterion-green="<%= kpi.criterion_green || '' %>"
        data-weight="<%= (kpi.peso !== null && kpi.peso !== undefined) ? kpi.peso : 0 %>"
      >
        <td><strong><%= kpi.nombre %></strong></td>
        <td><%= kpi.objetivo %></td>
        <td><%= kpi.unidad %></td>
        <td>
          <%
            const fmt = (v) => {
              if (v === null || v === undefined || v === '') return '';
              const n = Number(v);
              if (!Number.isFinite(n)) return String(v);
              const s = String(n);
              // 80.00 -> 80 ; 80.50 -> 80.5
              return s.replace(/\.0+$/,'').replace(/(\.\d*[1-9])0+$/,'$1');
            };

            const st = (kpi.score_type || '').toUpperCase();
            const dir = (kpi.direction || 'HIGHER_BETTER').toUpperCase();
            const ty = (kpi.threshold_yellow ?? '');
            const tg = (kpi.threshold_green ?? '');
            const hasThresholds = (ty !== '' && tg !== '');
            const cr = (kpi.criterion_red || '');
            const cy = (kpi.criterion_yellow || '');
            const cg = (kpi.criterion_green || '');
            const hasCriteria = (cr || cy || cg);
          %>

          <% if (st === 'CRITERION') { %>
            <% if (hasCriteria) { %>
              <small>
                Rojo: <%= cr || '-' %><br>
                Amarillo: <%= cy || '-' %><br>
                Verde: <%= cg || '-' %>
              </small>
            <% } else { %>
              <small class="text-muted">(Sin criterios definidos en Catálogo)</small>
            <% } %>
          <% } else { %>
            <% if (hasThresholds) { %>
              <small>
                <span class="text-muted">Sentido:</span>
                <strong><%= dir === 'LOWER_BETTER' ? '↓' : '↑' %></strong><br>

                <span class="text-muted">Amarillo:</span>
                <strong><%= fmt(ty) %></strong><br>

                <span class="text-muted">Verde:</span>
                <strong><%= fmt(tg) %></strong>

                <div class="text-muted" style="font-size: 11px; line-height: 1.2; margin-top:4px;">
                  Rojo: <%= dir === 'LOWER_BETTER' ? 'mayor a Amarillo' : 'menor a Amarillo' %>
                </div>
              </small>
            <% } else { %>
              <small class="text-muted">(Sin umbrales definidos en Catálogo)</small>
            <% } %>
          <% } %>
        </td>

        <td class="p-1">
          <form method="post" action="/dashboard/save" class="d-flex align-items-center" data-kpi-form data-kpi-id="<%= kpi.id %>">
            <input type="hidden" name="kpi_id" value="<%= kpi.id %>">
            <input type="hidden" name="anio" value="<%= selectedYear %>">
            <input type="hidden" name="mes" value="<%= selectedMonth %>">
            <% if ((kpi.score_type || '').toUpperCase() === 'CRITERION' && (kpi.criterion_red || kpi.criterion_yellow || kpi.criterion_green)) { %>
              <select name="valor"
                      class="form-select form-select-sm <%= colorClass %>"
                      style="width:190px;"
                      data-kpi-valor
                      <%= isLocked ? 'disabled' : '' %>>
                <option value="" <%= (res.valor || '') === '' ? 'selected' : '' %>>(Selecciona...)</option>
                <% if (kpi.criterion_red) { %>
                  <option value="<%= kpi.criterion_red %>" <%= (res.valor === kpi.criterion_red) ? 'selected' : '' %>><%= kpi.criterion_red %></option>
                <% } %>
                <% if (kpi.criterion_yellow) { %>
                  <option value="<%= kpi.criterion_yellow %>" <%= (res.valor === kpi.criterion_yellow) ? 'selected' : '' %>><%= kpi.criterion_yellow %></option>
                <% } %>
                <% if (kpi.criterion_green) { %>
                  <option value="<%= kpi.criterion_green %>" <%= (res.valor === kpi.criterion_green) ? 'selected' : '' %>><%= kpi.criterion_green %></option>
                <% } %>
              </select>
            <% } else { %>
              <input type="text"
                     class="form-control form-control-sm <%= colorClass %>"
                     name="valor"
                     value="<%= res.valor || '' %>"
                     style="width:85px;"
                     data-kpi-valor
                     <%= isLocked ? 'disabled' : '' %>>
            <% } %>
            <button type="submit" class="btn btn-sm btn-outline-primary ms-1" title="Guardar" <%= isLocked ? 'disabled' : '' %>>
              <span>✔</span>
            </button>

            <!-- Puntaje dentro del semáforo (sin EJS dentro de style para evitar error CSS) -->
            <span class="badge ms-2 <%= puntaje === '' ? 'd-none' : '' %> <%= (res.color==='rojo') ? 'bg-danger text-light' : (res.color==='amarillo' ? 'bg-warning text-dark' : (res.color==='verde' ? 'bg-success text-light' : 'bg-light text-dark border')) %>"
                  data-kpi-scorebadge
                  style="min-width:52px; text-align:center;">
              <%= puntaje %>
            </span>
          </form>

          <div class="d-flex align-items-center flex-wrap gap-1 mt-1">
            <span class="badge <%= estadoClass %>" data-status-badge><%= estado %></span>
            <small class="text-muted" data-status-meta>
              <% if (estado === 'APROBADO') { %>
                por <strong><%= res.visto_nombre || '—' %></strong> · <%= fmtDate(res.visto_fecha) || '' %>
              <% } else if (estado === 'EN REVISIÓN') { %>
                por <strong><%= res.revision_nombre || '—' %></strong> · <%= fmtDate(res.revision_fecha) || '' %>
                <% if (res.revision_motivo) { %>
                  <span class="text-muted">· <em><%= res.revision_motivo %></em></span>
                <% } %>
              <% } %>
            </small>

            <% if (canApproveSelf && !isLocked) { %>
              <button type="button" class="btn btn-sm btn-outline-success ms-2" data-lock-toggle data-action="approve">✅ Aprobar</button>
            <% } %>

            <%
              // Mostrar botón para reabrir (enviar a revisión) cuando el KPI está cerrado
              // y el propio usuario no tiene jefe directo (puede auto-reabrir).  Se usa
              // el mismo mecanismo de aprobación/revisión que para el equipo.
              if (isLocked && canApproveSelf) { %>
              <button type="button" class="btn btn-sm btn-outline-warning ms-2" data-lock-toggle data-action="review">
                ↩ Reabrir
              </button>
            <% } %>
            <% if (isLocked) { %>
              <span class="badge bg-dark ms-1" data-lock-badge title="Aprobado / cerrado">🔒</span>
            <% } %>
          </div>
        </td>

        <!-- Nuevo: columna de peso (%) -->
        <td class="text-center">
          <% /* Formatear el peso al vuelo: muestra hasta 2 decimales y elimina ceros innecesarios */ %>
          <%= (kpi.peso !== null && kpi.peso !== undefined) ?
              String(Number(kpi.peso).toFixed(2)).replace(/\.0+$/, '').replace(/(\.\d*[1-9])0+$/, '$1') : '0' %>%
        </td>

        <!-- Nuevo: columna de puntaje ponderado -->
        <td class="text-center">
          <% /* Si no hay puntaje o peso, muestra vacío.  weightedScore ya fue calculado arriba */ %>
          <% if (weightedScore === '') { %>
            <span
              data-weighted-score
              data-ws=""
              class="badge bg-light text-dark border"
            >
              —
            </span>
          <% } else { %>
            <span
              data-weighted-score
              data-ws="<%= weightedScore %>"
              class="badge <%= (res.color==='rojo') ? 'bg-danger text-light' : (res.color==='amarillo' ? 'bg-warning text-dark' : (res.color==='verde' ? 'bg-success text-light' : 'bg-light text-dark border')) %>"
            >
              <%= weightedScore %>
            </span>
          <% } %>
        </td>

        <td>
          <form method="post" action="/dashboard/save" data-kpi-comment-form data-kpi-id="<%= kpi.id %>" class="d-flex gap-1 align-items-start">
            <input type="hidden" name="kpi_id" value="<%= kpi.id %>">
            <input type="hidden" name="anio" value="<%= selectedYear %>">
            <input type="hidden" name="mes" value="<%= selectedMonth %>">
            <!-- Nota: el comentario se guarda sin forzar el valor del KPI (evita sobrescribir el resultado). -->
            <textarea name="comentario"
                      class="form-control form-control-sm"
                      rows="1"
                      style="min-width:260px;"
                      placeholder="Comentario del KPI..."
                      <%= isLocked ? 'disabled' : '' %>><%= res.comentario || '' %></textarea>
            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Guardar comentario" <%= isLocked ? 'disabled' : '' %>>💾</button>
            <!-- Estado de guardado del comentario -->
            <small data-comment-status class="ms-2 text-success"></small>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

  <!-- Resumen de puntajes ponderados del periodo -->
  <div class="mt-3">
    <% 
      // Calcular totales del mes.  Redondeamos a dos decimales y limpiamos ceros finales.
      const _total = totalWeightedScore || 0;
      const totalDisplay = _total.toFixed(2).replace(/\.0+$/,'').replace(/(\.\d*[1-9])0+$/,'$1');
      let generalColorClass = '';
      let generalText = '';
      // Ajuste de umbrales: rojo hasta 40.99, amarillo de 41 a 70.99, verde desde 71
      if (_total >= 71) {
        generalColorClass = 'bg-success text-light';
        generalText = 'Verde';
      } else if (_total >= 41) {
        generalColorClass = 'bg-warning text-dark';
        generalText = 'Amarillo';
      } else {
        generalColorClass = 'bg-danger text-light';
        generalText = 'Rojo';
      }
    %>
    <div class="d-flex flex-wrap align-items-center gap-2">
      <!-- Etiqueta de resumen más intuitiva -->
      <strong>Resultado final del mes:</strong>
      <span
        data-total-weighted
        class="badge bg-light text-dark border"
      ><%= totalDisplay %></span>
      <span
        data-total-color
        class="badge <%= generalColorClass %>"
      ><%= generalText %></span>
    </div>
    <small class="text-muted">El máximo posible es 100 puntos si todos los KPIs están en verde.</small>
  </div>

<!-- Retroalimentación del periodo (plegable) -->
<div class="card mt-3 mb-4">
  <div class="card-header d-flex align-items-center justify-content-between">
    <div>
      <strong>Retroalimentación del periodo</strong>
      <span class="text-muted">(Fortalezas, Áreas de oportunidad, Compromisos)</span>
    </div>
    <button class="btn btn-sm btn-outline-secondary" type="button" data-toggle-retro data-target="#retro-self">
      ▸ Desplegar retro
    </button>
  </div>
  <div class="card-body" id="retro-self" style="display:none;">
    <form method="post" action="/dashboard/feedback/save" data-feedback-form>
      <input type="hidden" name="anio" value="<%= selectedYear %>">
      <input type="hidden" name="mes" value="<%= selectedMonth %>">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">Fortalezas</label>
          <textarea name="fortalezas" class="form-control" rows="4" placeholder="Escribe fortalezas..." ><%= (feedback && feedback.fortalezas) || '' %></textarea>
        </div>
        <div class="col-md-4">
          <label class="form-label">Áreas de oportunidad</label>
          <textarea name="oportunidades" class="form-control" rows="4" placeholder="Escribe áreas de oportunidad..." ><%= (feedback && feedback.oportunidades) || '' %></textarea>
        </div>
        <div class="col-md-4">
          <label class="form-label">Compromisos</label>
          <textarea name="compromisos" class="form-control" rows="4" placeholder="Escribe compromisos..." ><%= (feedback && feedback.compromisos) || '' %></textarea>
        </div>
      </div>
      <div class="mt-3 d-flex align-items-center gap-2">
        <button type="submit" class="btn btn-primary">Guardar retroalimentación</button>
        <span data-feedback-status class="text-muted small"></span>
      </div>
    </form>
  </div>
</div>

<hr>
<div class="d-flex flex-wrap align-items-end justify-content-between gap-2">
  <div>
    <h3 class="mb-0">KPIs de mi equipo</h3>
    <div class="text-muted small">Busca un colaborador por nombre/apellido o No. empleado (solo verás a tu jerarquía).</div>
  </div>
  <div class="d-flex align-items-center gap-2" style="min-width:360px;">
    <input id="teamSearchInput" type="text" class="form-control form-control-sm" placeholder="Ej. Gabriela / Hernández / 04886" autocomplete="off">
    <button id="teamSearchBtn" type="button" class="btn btn-sm btn-outline-primary" style="white-space:nowrap;">Buscar</button>
  </div>
</div>

<!-- Herramientas de Ruta removidas: la exportación e importación de rutas se trasladaron a la nueva página de administración -->
<% if (!subordinateTree || subordinateTree.length === 0) { %>
  <p>No tienes colaboradores asignados.</p>
<% } else { %>
  <% /*
     Agrupar los colaboradores de primer nivel por sucursal para Operaciones.
     Usamos el mismo parcial `sub_kpi_level` que ya agrupa por sucursal y ruta.
     Esto permite que un supervisor vea sus sucursales (reales y virtuales) como tarjetas
     individuales, cada una con los colaboradores dentro.  Si se requieren niveles
     adicionales, éstos seguirán cargándose por AJAX desde /dashboard/subtree/.
  */ %>
  <%- include('partials/sub_kpi_level', { nodes: subordinateTree, selectedMonth: selectedMonth, selectedYear: selectedYear, groupBySucursal: useBranchGrouping }) %>
<% } %>

<!--
  Carga bajo demanda (un nivel por click):
  - El dashboard carga SOLO subordinados directos.
  - Cada botón "Desplegar siguiente nivel" trae por fetch() el siguiente nivel
    desde /dashboard/subtree/:empleadoId y lo inserta en el contenedor.
-->
<script>
  (function(){
    // Robustez: evita "Expression expected" si selectedYear/selectedMonth vienen vacíos
    // y evita "Cannot redeclare..." usando nombres internos.
    const _selectedYear  = Number("<%= (selectedYear !== undefined && selectedYear !== null) ? selectedYear : '' %>") || new Date().getFullYear();
    const _selectedMonth = Number("<%= (selectedMonth !== undefined && selectedMonth !== null) ? selectedMonth : '' %>") || (new Date().getMonth() + 1);
    const _includeBajas = "<%= _showBajas ? '1' : '0' %>";

    // Buscador de colaborador (cliente): NO filtra, solo localiza y hace scroll
    const teamSearchInput = document.getElementById('teamSearchInput');
    const teamSearchBtn = document.getElementById('teamSearchBtn');
    const norm = (s) => String(s || '').toLowerCase().normalize('NFD').replace(/\p{Diacritic}/gu,'').trim();
    function openAncestorCollapses(el){
      // Abrir cualquier collapse padre (por sucursal) para que el colaborador sea visible
      let cur = el;
      while (cur) {
        if (cur.classList && cur.classList.contains('collapse')) {
          cur.classList.add('show');
          cur.style.height = '';
          // Intentar actualizar el botón del header si existe
          const id = cur.getAttribute('id');
          if (id) {
            const btn = document.querySelector(`[data-bs-target="#${id}"]`);
            if (btn) {
              btn.setAttribute('aria-expanded','true');
              if (btn.textContent && btn.textContent.includes('▸')) btn.textContent = '▾';
            }
          }
        }
        cur = cur.parentElement;
      }
    }
    function highlightCard(card){
      card.classList.add('team-search-highlight');
      setTimeout(() => card.classList.remove('team-search-highlight'), 2500);
    }
    function findAndFocus(){
      if (!teamSearchInput) return;
      const qRaw = teamSearchInput.value;
      const q = norm(qRaw);
      if (!q) return;

      const cards = Array.from(document.querySelectorAll('[data-team-card]'));
      const match = cards.find(card => {
        const hay = norm((card.dataset.empNo||'') + ' ' + (card.dataset.empName||''));
        return hay.includes(q);
      });

      if (!match) {
        // Feedback simple sin romper layout
        teamSearchInput.classList.add('is-invalid');
        setTimeout(() => teamSearchInput.classList.remove('is-invalid'), 1200);
        return;
      }

      // Asegurar que sea visible (abrir collapses padre)
      openAncestorCollapses(match);
      // Scroll y resalte
      match.scrollIntoView({ behavior: 'smooth', block: 'start' });
      highlightCard(match);
    }
    if (teamSearchBtn) teamSearchBtn.addEventListener('click', findAndFocus);
    if (teamSearchInput) teamSearchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        findAndFocus();
      }
    });

    /*
     * Filtro de equipo
     *
     * En versiones anteriores se definía una función global `applyTeamFilter()`
     * que se encargaba de aplicar filtros visuales a las tarjetas del equipo
     * (por ejemplo, ocultar colaboradores que no coincidían con una búsqueda o
     * resaltar ciertos registros).  Durante una refactorización reciente se
     * eliminó accidentalmente su definición, pero la llamada siguió presente
     * después de cargar un nuevo nivel de colaboradores mediante AJAX.
     *
     * Cuando `applyTeamFilter` no está definida, llamar a ella provoca un
     * `ReferenceError` en tiempo de ejecución.  Ese error se intercepta en
     * la función `loadNextLevel()` y se traduce en un mensaje genérico de
     * "Error de red al cargar el nivel", lo que confunde al usuario porque
     * no hay un problema real de conexión.  Para evitar este fallo y
     * restaurar el comportamiento esperado, definimos a continuación
     * `applyTeamFilter` como una función de no‑operación (no-op).  Si en el
     * futuro se reintroducen filtros específicos, su lógica puede añadirse
     * aquí sin romper la carga por niveles.
     */
    function applyTeamFilter() {
      // No hacer nada por defecto.  Esta función sirve como hook para
      // aplicar filtros visuales opcionales una vez que se hayan cargado
      // dinámicamente nuevos niveles del equipo.  Si no se necesita
      // filtrar o destacar colaboradores adicionales, se deja vacío.
    }

    async function loadNextLevel(empId) {
      const container = document.getElementById('subtree-' + empId);
      const btn = document.querySelector(`[data-subtree-btn][data-emp-id="${empId}"]`);
      if (!container) return;

      // Si ya está cargado, solo alterna visibilidad
      if (container.dataset.loaded === '1') {
        const willShow = (container.style.display === 'none' || container.style.display === '');
        container.style.display = willShow ? 'block' : 'none';
        if (btn) btn.textContent = willShow ? '▾ Contraer nivel' : '▸ Desplegar nivel';
        return;
      }

      // Estado de carga
      container.style.display = 'block';
      container.innerHTML = '<div class="text-muted small">Cargando...</div>';

      try {
        const resp = await fetch(`/dashboard/subtree/${empId}?anio=${_selectedYear}&mes=${_selectedMonth}&showBajas=${_includeBajas}`, {
          headers: { 'X-Requested-With': 'fetch' }
        });
        if (!resp.ok) {
          const msg = await resp.text();
          container.innerHTML = `<div class="text-danger small">${msg || 'No se pudo cargar el nivel.'}</div>`;
          return;
        }
        const html = await resp.text();
        container.innerHTML = html;
        container.dataset.loaded = '1';
        if (btn) btn.textContent = '▾ Contraer nivel';
        applyTeamFilter();
      } catch (e) {
        container.innerHTML = '<div class="text-danger small">Error de red al cargar el nivel.</div>';
      }
    }

    // Un solo listener por delegación (funciona también para contenido cargado por AJAX)
    document.addEventListener('click', function(e){
      const btn = e.target.closest('[data-subtree-btn]');
      if (!btn) return;
      e.preventDefault();
      const empId = btn.dataset.empId;
      if (!empId) return;
      loadNextLevel(empId);
    });

    // Guardado rápido (AJAX) para evitar recargar toda la página al capturar un KPI
    document.addEventListener('submit', async function(e){
      const form = e.target;
      if (!form.matches('form[data-kpi-form]')) return;
      e.preventDefault();

      const row = form.closest('tr');
      const input = form.querySelector('[data-kpi-valor]');
      const btn = form.querySelector('button[type="submit"]');
      if (btn) btn.disabled = true;

      try {
        const resp = await fetch(form.action, {
          method: 'POST',
          headers: {
            'X-Requested-With': 'fetch',
            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
          },
          body: new URLSearchParams(new FormData(form)).toString()
        });
        const data = await resp.json().catch(()=>({}));
        if (!resp.ok || (data && data.ok === false)) {
          if (resp.status === 423 || (data && data.locked)) {
            alert((data && data.error) || 'Este KPI está cerrado.');
            return;
          }
          throw new Error((data && data.error) || ('HTTP ' + resp.status));
        }

        // Actualizar color (clases bootstrap) sin recargar
        if (input && input.dataset.kpiValor !== undefined) {
          input.classList.remove('bg-danger', 'bg-warning', 'bg-success', 'text-light');
          if (data && data.color) {
            if (data.color === 'rojo') input.classList.add('bg-danger', 'text-light');
            if (data.color === 'amarillo') input.classList.add('bg-warning');
            if (data.color === 'verde') input.classList.add('bg-success', 'text-light');
          }
        }

        // Actualizar puntaje dentro del semáforo (badge)
        const scoreBadge = row ? row.querySelector('[data-kpi-scorebadge]') : null;
        if (scoreBadge && data && typeof data.puntaje !== 'undefined') {
          const p = (data.puntaje === null) ? '' : String(data.puntaje);
          scoreBadge.textContent = p;
          scoreBadge.style.display = p ? 'inline-block' : 'none';
          scoreBadge.classList.remove('bg-danger','bg-warning','bg-success','bg-light','text-dark','text-light','border');
          if (data.color === 'rojo') scoreBadge.classList.add('bg-danger','text-light');
          else if (data.color === 'amarillo') scoreBadge.classList.add('bg-warning','text-dark');
          else if (data.color === 'verde') scoreBadge.classList.add('bg-success','text-light');
          else scoreBadge.classList.add('bg-light','text-dark','border');
        }

        // Recalcular y actualizar puntaje ponderado y totales utilizando los valores
        // devueltos por el backend cuando sea posible.  Si el servidor no envía
        // puntaje_ponderado ni total_mes_empleado, se usan los cálculos del cliente.
        try {
          const kpiRow = form.closest('tr[data-kpi-row]');
          if (kpiRow) {
            // Actualizar el puntaje ponderado de la fila
            const wsBadge = kpiRow.querySelector('[data-weighted-score]');
            if (data && Object.prototype.hasOwnProperty.call(data, 'puntaje_ponderado') && wsBadge) {
              const wsVal = data.puntaje_ponderado;
              if (wsVal === null || wsVal === '' || wsVal === undefined) {
                wsBadge.textContent = '—';
                wsBadge.dataset.ws = '';
              } else {
                wsBadge.textContent = String(wsVal);
                wsBadge.dataset.ws = String(wsVal);
              }
              // Actualizar clases según color devuelto
              wsBadge.classList.remove('bg-danger','bg-warning','bg-success','bg-light','text-dark','text-light','border');
              if (data.color === 'rojo') wsBadge.classList.add('bg-danger','text-light');
              else if (data.color === 'amarillo') wsBadge.classList.add('bg-warning','text-dark');
              else if (data.color === 'verde') wsBadge.classList.add('bg-success','text-light');
              else wsBadge.classList.add('bg-light','text-dark','border');
            } else if (wsBadge) {
              // Fallback: calcular en cliente cuando no se recibió el puntaje
              const valInput = form.querySelector('[data-kpi-valor]');
              const rawVal = valInput ? valInput.value : '';
              updateRowWeighted(kpiRow, rawVal);
            }
            // Actualizar totales y semáforo para el colaborador (tarjeta de equipo) o para mí
            const card = kpiRow.closest('[data-team-card]');
            if (card && data && Object.prototype.hasOwnProperty.call(data, 'total_mes_empleado')) {
              const tot = data.total_mes_empleado;
              const colorRes = data.color_resultado_mes;
              // Total para el colaborador
              card.querySelectorAll('[data-sub-total-weighted]').forEach(function(el){
                el.textContent = (tot === null || tot === undefined || tot === '') ? '—' : String(tot);
              });
              card.querySelectorAll('[data-sub-total-color]').forEach(function(el){
                let cls = 'badge ';
                let txt = '';
                if (colorRes === 'verde') { cls += 'bg-success text-light'; txt = 'Verde'; }
                else if (colorRes === 'amarillo') { cls += 'bg-warning text-dark'; txt = 'Amarillo'; }
                else if (colorRes === 'rojo') { cls += 'bg-danger text-light'; txt = 'Rojo'; }
                else { cls += 'bg-light text-dark border'; txt = ''; }
                el.className = cls;
                el.textContent = txt;
              });
            } else if (!card && data && Object.prototype.hasOwnProperty.call(data, 'total_mes_empleado')) {
              // Actualizar mi propio total ponderado
              const tot = data.total_mes_empleado;
              const colorRes = data.color_resultado_mes;
              const totSpan = document.querySelector('[data-total-weighted]');
              const colSpan = document.querySelector('[data-total-color]');
              if (totSpan) totSpan.textContent = (tot === null || tot === undefined || tot === '') ? '—' : String(tot);
              if (colSpan) {
                let cls = 'badge ';
                let txt = '';
                if (colorRes === 'verde') { cls += 'bg-success text-light'; txt = 'Verde'; }
                else if (colorRes === 'amarillo') { cls += 'bg-warning text-dark'; txt = 'Amarillo'; }
                else if (colorRes === 'rojo') { cls += 'bg-danger text-light'; txt = 'Rojo'; }
                else { cls += 'bg-light text-dark border'; txt = ''; }
                colSpan.className = cls;
                colSpan.textContent = txt;
              }
            } else {
              // Fallback: usar cálculo en cliente cuando no se recibieron totales
              if (!card) {
                updateTotalSummary();
              } else {
                updateTeamMemberSummary(card);
              }
            }
          }
        } catch (ex) {
          console.error('Error al actualizar puntaje ponderado:', ex);
        }
      } catch (err) {
        console.error('Error guardando KPI:', err);
        if (input) input.classList.add('is-invalid');
        setTimeout(()=>{ if (input) input.classList.remove('is-invalid'); }, 1200);
      } finally {
        if (btn) btn.disabled = false;
      }
    });

    /**
     * Calcula el color y puntaje base de un KPI dado su tipo y valor.
     * Replica la lógica del backend (services/kpiScoring.js).
     *
     * @param {HTMLElement} row - fila TR con data-* que define score_type, direction, thresholds y criterios.
     * @param {string|number|null} rawValue - valor del campo capturado.
     * @returns {{color: ('rojo'|'amarillo'|'verde'|null), score: (number|null)}}
     */
    function computeKpiScore(row, rawValue) {
      if (!row) return { color: null, score: null };
      const st = (row.dataset.scoreType || '').toUpperCase();
      const dir = (row.dataset.direction || 'HIGHER_BETTER').toUpperCase();
      // Si es CRITERION: comparar con criterios exactos
      if (st === 'CRITERION') {
        const v = (rawValue === null || rawValue === undefined) ? '' : String(rawValue).trim();
        const cr = (row.dataset.criterionRed || '').trim();
        const cy = (row.dataset.criterionYellow || '').trim();
        const cg = (row.dataset.criterionGreen || '').trim();
        if (!cr && !cy && !cg) {
          return { color: null, score: null };
        }
        if (cg && v === cg) return { color: 'verde', score: 100 };
        if (cy && v === cy) return { color: 'amarillo', score: 70 };
        if (cr && v === cr) return { color: 'rojo', score: 40 };
        return { color: null, score: null };
      }
      // NUMBER/PERCENT: thresholds
      const parseNum = (val) => {
        if (val === null || val === undefined) return null;
        if (typeof val === 'number') return Number.isFinite(val) ? val : null;
        const s = String(val).replace('%', '').trim().replace(',', '.');
        if (!s) return null;
        const n = parseFloat(s);
        return Number.isFinite(n) ? n : null;
      };
      const n = parseNum(rawValue);
      const ty = parseNum(row.dataset.thresholdYellow);
      const tg = parseNum(row.dataset.thresholdGreen);
      if (n === null || ty === null || tg === null) {
        return { color: null, score: null };
      }
      if (dir === 'HIGHER_BETTER') {
        if (n >= tg) return { color: 'verde', score: 100 };
        if (n >= ty) return { color: 'amarillo', score: 70 };
        return { color: 'rojo', score: 40 };
      } else { // LOWER_BETTER
        if (n <= tg) return { color: 'verde', score: 100 };
        if (n <= ty) return { color: 'amarillo', score: 70 };
        return { color: 'rojo', score: 40 };
      }
    }

    /**
     * Actualiza el puntaje ponderado y estilos de una fila de KPI en la tabla "Mis KPIs".
     * @param {HTMLElement} row - la fila TR del KPI.
     * @param {string|number|null} rawValue - valor ingresado por el usuario.
     */
    function updateRowWeighted(row, rawValue) {
      if (!row) return;
      const { color, score } = computeKpiScore(row, rawValue);
      // Peso
      const weight = parseFloat(row.dataset.weight) || 0;
      let ws = null;
      if (score !== null && weight) {
        ws = (score * (weight / 100));
      }
      // Encontrar la celda/ badge del puntaje ponderado
      const badge = row.querySelector('[data-weighted-score]');
      if (badge) {
        if (ws === null) {
          badge.textContent = '—';
          badge.dataset.ws = '';
          badge.className = 'badge bg-light text-dark border';
        } else {
          // Formateo: hasta 2 decimales sin ceros extras
          const formatted = ws.toFixed(2).replace(/\.0+$/, '').replace(/(\.\d*[1-9])0+$/, '$1');
          badge.textContent = formatted;
          badge.dataset.ws = formatted;
          // Actualizar clases según color
          badge.classList.remove('bg-danger','bg-warning','bg-success','bg-light','text-dark','text-light','border');
          if (color === 'rojo') badge.classList.add('bg-danger','text-light');
          else if (color === 'amarillo') badge.classList.add('bg-warning','text-dark');
          else if (color === 'verde') badge.classList.add('bg-success','text-light');
          else badge.classList.add('bg-light','text-dark','border');
        }
      }
      // Actualizar clase de color en el campo de captura si existe
      const inputEl = row.querySelector('[data-kpi-valor]');
      if (inputEl) {
        inputEl.classList.remove('bg-danger','bg-warning','bg-success','text-light');
        if (color === 'rojo') inputEl.classList.add('bg-danger','text-light');
        else if (color === 'amarillo') inputEl.classList.add('bg-warning');
        else if (color === 'verde') inputEl.classList.add('bg-success','text-light');
      }
    }

    /**
     * Recalcula el total ponderado y el semáforo general en el resumen inferior.
     */
    function updateTotalSummary() {
      let total = 0;
      document.querySelectorAll('[data-weighted-score]').forEach(el => {
        const vStr = el.dataset.ws || el.textContent;
        const v = parseFloat(vStr);
        if (!isNaN(v)) total += v;
      });
      const totalSpan = document.querySelector('[data-total-weighted]');
      const colorSpan = document.querySelector('[data-total-color]');
      if (totalSpan) {
        // Formateo de total
        const formatted = total.toFixed(2).replace(/\.0+$/, '').replace(/(\.\d*[1-9])0+$/, '$1');
        totalSpan.textContent = formatted;
      }
      if (colorSpan) {
        // Determinar color general
        // Nuevos umbrales: rojo <= 40.99, amarillo 41-70.99, verde >= 71
        let genClass = '';
        let genText = '';
        if (total >= 71) {
          genClass = 'bg-success text-light';
          genText = 'Verde';
        } else if (total >= 41) {
          genClass = 'bg-warning text-dark';
          genText = 'Amarillo';
        } else {
          genClass = 'bg-danger text-light';
          genText = 'Rojo';
        }
        // Limpiar clases previas excepto 'badge'
        colorSpan.className = 'badge ' + genClass;
        colorSpan.textContent = genText;
      }
    }

    /**
     * Recalcula el total ponderado y el color general para un colaborador (tarjeta de equipo).
     * Busca todas las filas de KPI dentro de la tarjeta, calcula el puntaje ponderado de cada KPI
     * en base al valor capturado y al peso, y actualiza las insignias de total y color.
     *
     * @param {HTMLElement} card - El contenedor `.card` con atributo `data-team-card`.
     */
    function updateTeamMemberSummary(card) {
      if (!card) return;
      let total = 0;
      // Iterar sobre las filas de KPI dentro de esta tarjeta
      card.querySelectorAll('tr[data-kpi-row]').forEach(row => {
        const inp = row.querySelector('[data-kpi-valor]');
        const rawVal = inp ? inp.value : '';
        const { color, score } = computeKpiScore(row, rawVal);
        const weight = parseFloat(row.dataset.weight) || 0;
        if (score !== null && weight) {
          total += score * (weight / 100);
        }
      });
      // Formatear el total con hasta 2 decimales sin ceros extra
      const formatted = total.toFixed(2).replace(/\.0+$/, '').replace(/(\.\d*[1-9])0+$/, '$1');
      // Determinar color general según el total ponderado
      // Nuevos umbrales: rojo hasta 40.99, amarillo 41-70.99, verde desde 71
      let genClass = '';
      let genText = '';
      if (total >= 71) {
        genClass = 'bg-success text-light';
        genText = 'Verde';
      } else if (total >= 41) {
        genClass = 'bg-warning text-dark';
        genText = 'Amarillo';
      } else {
        genClass = 'bg-danger text-light';
        genText = 'Rojo';
      }
      // Actualizar las insignias de total ponderado
      card.querySelectorAll('[data-sub-total-weighted]').forEach(el => {
        el.textContent = formatted;
      });
      // Actualizar las insignias de color
      card.querySelectorAll('[data-sub-total-color]').forEach(el => {
        el.textContent = genText;
        el.className = 'badge ' + genClass;
      });
    }

    // Delegación para actualizar el color del campo en tiempo real al capturar valor del KPI.
    // Para evitar confusión, el puntaje ponderado y los totales no se recalculan hasta que se presione
    // la palomita (submit).  Solo se actualiza la clase de color del input.
    function updateInputColorOnly(row, rawValue) {
      if (!row) return;
      const { color } = computeKpiScore(row, rawValue);
      const inputEl = row.querySelector('[data-kpi-valor]');
      if (inputEl) {
        inputEl.classList.remove('bg-danger','bg-warning','bg-success','text-light');
        if (color === 'rojo') inputEl.classList.add('bg-danger','text-light');
        else if (color === 'amarillo') inputEl.classList.add('bg-warning');
        else if (color === 'verde') inputEl.classList.add('bg-success','text-light');
      }
    }
    document.addEventListener('input', function(ev) {
      const inp = ev.target;
      if (!inp || !inp.matches('[data-kpi-valor]')) return;
      const row = inp.closest('tr[data-kpi-row]');
      if (!row) return;
      updateInputColorOnly(row, inp.value);
    });
    document.addEventListener('change', function(ev) {
      const inp = ev.target;
      if (!inp || !inp.matches('[data-kpi-valor]')) return;
      const row = inp.closest('tr[data-kpi-row]');
      if (!row) return;
      updateInputColorOnly(row, inp.value);
    });

    // Actualizar puntajes ponderados después de guardar un KPI via AJAX
    // Se extiende el listener existente (data-kpi-form submit) para recalcular la fila y total
    // Guardado de comentario (AJAX) sin tocar el semáforo
    document.addEventListener('submit', async function(e){
      const form = e.target;
      if (!form.matches('form[data-kpi-comment-form]')) return;
      e.preventDefault();

      const btn = form.querySelector('button[type="submit"]');
      if (btn) btn.disabled = true;

      try {
        const resp = await fetch(form.action, {
          method: 'POST',
          headers: {
            'X-Requested-With': 'fetch',
            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
          },
          body: new URLSearchParams(new FormData(form)).toString()
        });
        const data = await resp.json().catch(()=>({}));
        if (!resp.ok || (data && data.ok === false)) {
          throw new Error((data && data.error) || ('HTTP ' + resp.status));
        }
        // Mostrar mensaje "Guardado" junto al comentario
        const statusEl = form.querySelector('[data-comment-status]');
        if (statusEl) {
          statusEl.textContent = 'Guardado ✔';
          statusEl.classList.remove('text-danger');
          statusEl.classList.add('text-success');
          // Limpiar mensaje después de 1.5 segundos
          setTimeout(() => { statusEl.textContent = ''; }, 1500);
        }
        // Cambio visual en el botón (breve)
        if (btn) {
          btn.classList.add('btn-success');
          setTimeout(()=>btn.classList.remove('btn-success'), 600);
        }
      } catch (err) {
        console.error('Error guardando comentario:', err);
        const statusEl = form.querySelector('[data-comment-status]');
        if (statusEl) {
          statusEl.textContent = 'Error al guardar';
          statusEl.classList.remove('text-success');
          statusEl.classList.add('text-danger');
          setTimeout(() => { statusEl.textContent = ''; }, 2000);
        }
      } finally {
        if (btn) btn.disabled = false;
      }
    });

    // Mostrar/ocultar retroalimentación (para mí y para el equipo)
    document.addEventListener('click', function(e){
      const t = e.target.closest('[data-toggle-retro]');
      if (!t) return;
      e.preventDefault();
      const selector = t.getAttribute('data-target');
      const panel = selector ? document.querySelector(selector) : null;
      if (!panel) return;
      const willShow = (panel.style.display === 'none' || panel.style.display === '');
      panel.style.display = willShow ? 'block' : 'none';
      t.textContent = willShow ? '▾ Contraer retro' : '▸ Desplegar retro';
    });

    // Guardado rápido de retroalimentación (AJAX) por delegación
    document.addEventListener('submit', async function(e){
      const form = e.target;
      if (!form.matches('form[data-feedback-form]')) return;
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]');
      const status = form.querySelector('[data-feedback-status]');
      if (btn) btn.disabled = true;
      if (status) status.textContent = 'Guardando...';
      try {
        const resp = await fetch(form.action, {
          method: 'POST',
          headers: {
            'X-Requested-With': 'fetch',
            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
          },
          body: new URLSearchParams(new FormData(form)).toString()
        });
        const data = await resp.json().catch(()=>({}));
        if (!resp.ok || !data.ok) throw new Error((data && data.error) || 'No se pudo guardar');
        if (status) {
          status.textContent = 'Guardado ✔';
          setTimeout(()=>{ status.textContent = ''; }, 1500);
        }
      } catch (err) {
        console.error('Error guardando retroalimentación:', err);
        if (status) status.textContent = 'Error al guardar';
      } finally {
        if (btn) btn.disabled = false;
      }
    });

    // Aprobar / Enviar a revisión (sin recargar ni brincar de scroll)
    document.addEventListener('click', async function(e){
      const btn = e.target.closest('[data-lock-toggle]');
      if (!btn) return;
      e.preventDefault();
      const row = btn.closest('[data-kpi-row]');
      if (!row) return;
      const empleadoId = row.dataset.empleadoId;
      const kpiId = row.dataset.kpiId;
      const action = btn.dataset.action; // approve | review
      if (!empleadoId || !kpiId || !action) return;

      const endpoint = (action === 'review') ? '/dashboard/review' : '/dashboard/visto';
      const fd = new URLSearchParams();
      fd.set('empleado_id', empleadoId);
      fd.set('kpi_id', kpiId);
      fd.set('anio', String(_selectedYear));
      fd.set('mes', String(_selectedMonth));
      if (action === 'review') {
        const motivo = window.prompt('Motivo de revisión (opcional):', '') || '';
        fd.set('revision_motivo', motivo);
      }

      btn.disabled = true;
      try {
        const resp = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'X-Requested-With': 'fetch',
            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
          },
          body: fd.toString()
        });
        const data = await resp.json().catch(()=>({}));
        if (!resp.ok || !data.ok) throw new Error((data && data.error) || 'No se pudo aplicar');

        const statusBadge = row.querySelector('[data-status-badge]');
        const statusMeta = row.querySelector('[data-status-meta]');

        if (action === 'approve') {
          // Deshabilitar inputs
          row.querySelectorAll('input[name="valor"], select[name="valor"], textarea[name="comentario"], button[type="submit"]').forEach(el => {
            if (el === btn) return;
            el.setAttribute('disabled','disabled');
          });

          // Estado
          if (statusBadge) {
            statusBadge.textContent = 'APROBADO';
            statusBadge.className = 'badge bg-success text-light';
          }
          if (statusMeta) {
            const who = data.visto_nombre || '';
            const dt = data.visto_fecha ? new Date(data.visto_fecha).toLocaleDateString('es-MX') : '';
            statusMeta.innerHTML = who ? `por <strong>${who}</strong> · ${dt}` : '';
          }

          // Candado
          let lock = row.querySelector('[data-lock-badge]');
          if (!lock) {
            lock = document.createElement('span');
            lock.className = 'badge bg-dark ms-1';
            lock.setAttribute('data-lock-badge','');
            lock.title = 'Aprobado / cerrado';
            lock.textContent = '🔒';
            const cell = btn.closest('td');
            if (cell) cell.appendChild(lock);
          }

          // Mostrar botón "Enviar a revisión" si existe
          const reviewBtn = row.querySelector('[data-lock-toggle][data-action="review"]');
          if (reviewBtn) reviewBtn.classList.remove('d-none');
          btn.classList.add('d-none');
        } else {
          // review
          // Habilitar inputs
          row.querySelectorAll('input[name="valor"], select[name="valor"], textarea[name="comentario"], button[type="submit"]').forEach(el => {
            if (el === btn) return;
            el.removeAttribute('disabled');
          });

          // Estado
          if (statusBadge) {
            statusBadge.textContent = 'EN REVISIÓN';
            statusBadge.className = 'badge bg-warning text-dark';
          }
          if (statusMeta) {
            const who = data.revision_nombre || '';
            const dt = data.revision_fecha ? new Date(data.revision_fecha).toLocaleDateString('es-MX') : '';
            const motivo = data.revision_motivo ? ` · <em>${data.revision_motivo}</em>` : '';
            statusMeta.innerHTML = who ? `por <strong>${who}</strong> · ${dt}${motivo}` : '';
          }

          // Quitar candado
          const lock = row.querySelector('[data-lock-badge]');
          if (lock) lock.remove();

          // Mostrar botón aprobar si permitido (data-can-approve)
          const approveBtn = row.querySelector('[data-lock-toggle][data-action="approve"]');
          if (approveBtn && row.dataset.canApprove === '1') approveBtn.classList.remove('d-none');
          btn.classList.add('d-none');
        }

      } catch (err) {
        console.error('Error aprobación/revisión:', err);
        alert(err.message || 'No se pudo aplicar');
      } finally {
        btn.disabled = false;
      }
    });

    // Enviar resultados por correo
    document.addEventListener('click', async function(e){
      const selfLink = e.target.closest('#send-self');
      const teamLink = e.target.closest('#send-team');
      const directLink = e.target.closest('#send-direct');
      if (!selfLink && !teamLink && !directLink) return;
      e.preventDefault();
      let url;
      let confirmMsg;
      let isTeam = false;
      let isDirect = false;
      if (teamLink) {
        url = '/dashboard/email/team';
        confirmMsg = '¿Enviar los resultados de KPIs a todos los integrantes de tu equipo?';
        isTeam = true;
      } else if (directLink) {
        url = '/dashboard/email/direct';
        confirmMsg = '¿Enviar los resultados de KPIs a tus subordinados directos?';
        isDirect = true;
      } else {
        url = '/dashboard/email/self';
        confirmMsg = '¿Enviar tus resultados de KPIs a tu correo registrado?';
      }
      const baseFd = { anio: String(_selectedYear), mes: String(_selectedMonth) };
      if (!window.confirm(confirmMsg)) return;
      try {
        const doSend = async (extra = {}) => {
          const fd = Object.assign({}, baseFd, extra);
          const resp = await fetch(url, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(fd)
          });
          const data = await resp.json().catch(() => ({}));
          return { resp, data };
        };

        // Primer intento (sin forzar reenvío / sin incluir ya enviados)
        let { resp, data } = await doSend();
        if (!resp.ok || (data && data.success === false)) {
          const err = (data && data.error) || 'No se pudo enviar el correo';
          alert(err);
          return;
        }
        if (isTeam || isDirect) {
          const count = data.count || 0;
          const skipped = data.skipped || 0;
          // Si hay correos ya enviados, preguntar si se desea incluirlos también
          if (!data.includedSent && skipped > 0) {
            const again = window.confirm(`Se omitieron ${skipped} colaborador${skipped === 1 ? '' : 'es'} porque ya se habían enviado antes.\n\n¿Deseas incluirlos y reenviarlos también?`);
            if (again) {
              ({ resp, data } = await doSend({ includeSent: true }));
              if (!resp.ok || (data && data.success === false)) {
                const err = (data && data.error) || 'No se pudo reenviar el correo';
                alert(err);
                return;
              }
              const count2 = data.count || 0;
              alert(`Correos enviados a ${count2} colaborador${count2 === 1 ? '' : 'es'} (incluyendo reenvíos).`);
              return;
            }
          }
          alert(`Correos enviados a ${count} colaborador${count === 1 ? '' : 'es'}.`);
        } else {
          if (data.skipped && !data.forced) {
            const again = window.confirm('Tus resultados ya habían sido enviados anteriormente.\n\n¿Deseas enviarlos nuevamente?');
            if (again) {
              ({ resp, data } = await doSend({ force: true }));
              if (!resp.ok || (data && data.success === false)) {
                const err = (data && data.error) || 'No se pudo reenviar el correo';
                alert(err);
                return;
              }
              alert('Correo reenviado correctamente a tu buzón.');
              return;
            }
            alert('Tus resultados ya habían sido enviados anteriormente.');
            return;
          }
          alert('Correo enviado correctamente a tu buzón.');
        }
      } catch (err) {
        console.error('Error al enviar correo:', err);
        alert('Ocurrió un error de red al enviar el correo.');
      }
    });
  })();
</script>

<%- include('partials/footer') %>
