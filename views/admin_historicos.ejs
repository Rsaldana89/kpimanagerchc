<%- include('partials/header'); %>
<%
  const fmt = d => { if(!d)return ''; const x=new Date(d); return isNaN(x)?'':x.toLocaleString('es-MX'); };
  const monthLabel = m => MONTHS[(Number(m)||1)-1] || `Mes ${m}`;
%>
<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
  <div><h1 class="h3 mb-1"><i class="bi bi-clock-history me-2"></i>Históricos de KPI</h1><div class="text-muted">Snapshots inmutables de periodos cerrados e históricos importados.</div></div>
  <% if (period) { %><a class="btn btn-outline-secondary" href="/admin/historicos"><i class="bi bi-arrow-left"></i> Volver</a><% } %>
</div>

<% if (!period) { %>
<div class="card mb-4"><div class="card-body">
  <h2 class="h5">Importar histórico</h2>
  <p class="text-muted small mb-3">Solo .xlsx, máximo 15 MB. Primero analiza; el servidor vuelve a validar al importar.</p>
  <form id="historyImportForm" method="POST" action="/admin/historicos/import" enctype="multipart/form-data">
    <div class="row g-2 align-items-end"><div class="col-lg-7"><label class="form-label">Archivo</label><input class="form-control" type="file" id="historyFile" name="archivo" accept=".xlsx" required></div><div class="col-lg-3"><button class="btn btn-outline-primary w-100" type="button" id="analyzeBtn"><i class="bi bi-search"></i> Analizar archivo</button></div></div>
    <div id="previewBox" class="mt-3 d-none"></div>
    <input type="hidden" name="asNewVersion" id="asNewVersion" value="0">
    <button class="btn btn-primary mt-3 d-none" type="submit" id="importBtn"><i class="bi bi-database-add"></i> Importar histórico</button>
  </form>
</div></div>

<div class="card mb-4"><div class="card-body"><form method="GET" class="row g-2 align-items-end"><div class="col-md-3"><label class="form-label">Año</label><input type="number" class="form-control" name="anio" min="2000" max="2100" value="<%= selectedYear || '' %>"></div><div class="col-md-3"><label class="form-label">Mes</label><select class="form-select" name="mes"><option value="">Todos</option><% MONTHS.forEach((m,i)=>{ %><option value="<%= i+1 %>" <%= Number(selectedMonth)===i+1?'selected':'' %>><%= m %></option><% }); %></select></div><div class="col-md-3"><button class="btn btn-outline-secondary w-100">Filtrar</button></div></form></div></div>

<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Periodo</th><th>Origen</th><th>Versión</th><th>Snapshot / importación</th><th>Colaboradores</th><th>Filas KPI</th><th>Creado por</th><th>Estado</th><th></th></tr></thead><tbody>
<% if (!periods.length) { %><tr><td colspan="9" class="text-center text-muted py-4">No hay históricos disponibles.</td></tr><% } %>
<% periods.forEach(p=>{ %><tr><td><strong><%= monthLabel(p.mes) %> <%= p.anio %></strong></td><td><span class="badge text-bg-<%= p.origen==='SYSTEM_CLOSE'?'primary':'info' %>"><%= p.origen==='SYSTEM_CLOSE'?'Sistema':'Excel importado' %></span></td><td>v<%= p.version %></td><td><%= fmt(p.snapshot_el || p.created_at) %></td><td><%= p.empleados_total %></td><td><%= Number(p.filas_kpi_total||0).toLocaleString('es-MX') %></td><td><%= p.creado_por_nombre || '—' %></td><td><span class="badge text-bg-<%= Number(p.es_actual)===1?'success':'secondary' %>"><%= Number(p.es_actual)===1?'Actual':'Versión anterior' %></span></td><td><a class="btn btn-sm btn-outline-primary" href="/admin/historicos/periodo/<%= p.id %>">Ver</a></td></tr><% }); %>
</tbody></table></div></div>
<% } else { %>
<div class="card mb-3"><div class="card-body"><div class="d-flex justify-content-between flex-wrap gap-3"><div><h2 class="h4 mb-1"><%= monthLabel(period.mes) %> <%= period.anio %> · v<%= period.version %></h2><div class="text-muted"><%= period.origen==='SYSTEM_CLOSE'?'Generado al cierre oficial':'Importado desde Excel' %> · <%= fmt(period.snapshot_el || period.created_at) %></div></div><div><a class="btn btn-success" href="/admin/historicos/periodo/<%= period.id %>/export"><i class="bi bi-file-earmark-excel"></i> Exportar Excel</a></div></div><div class="row g-2 mt-2"><div class="col-md-4"><div class="border rounded p-2"><div class="small text-muted">Colaboradores</div><strong><%= period.empleados_total %></strong></div></div><div class="col-md-4"><div class="border rounded p-2"><div class="small text-muted">Filas KPI</div><strong><%= Number(period.filas_kpi_total||0).toLocaleString('es-MX') %></strong></div></div><div class="col-md-4"><div class="border rounded p-2"><div class="small text-muted">Origen / estado</div><strong><%= period.origen %> · <%= Number(period.es_actual)===1?'Actual':'Superado' %></strong></div></div></div></div></div>

<div class="card mb-3"><div class="card-body"><form method="GET" class="row g-2 align-items-end"><div class="col-lg-3"><label class="form-label">Buscar</label><input class="form-control" name="buscar" value="<%= query.search || '' %>" placeholder="Nombre o No. empleado"></div><div class="col-lg-3"><label class="form-label">Puesto</label><select class="form-select" name="puesto"><option value="">Todos</option><% filters.puestos.forEach(v=>{ %><option <%= query.puesto===v?'selected':'' %>><%= v %></option><% }); %></select></div><div class="col-lg-2"><label class="form-label">Departamento</label><select class="form-select" name="departamento"><option value="">Todos</option><% filters.departamentos.forEach(v=>{ %><option <%= query.departamento===v?'selected':'' %>><%= v %></option><% }); %></select></div><div class="col-lg-2"><label class="form-label">Sucursal</label><select class="form-select" name="sucursal"><option value="">Todas</option><% filters.sucursales.forEach(v=>{ %><option <%= query.sucursal===v?'selected':'' %>><%= v %></option><% }); %></select></div><div class="col-lg-2"><button class="btn btn-outline-secondary w-100">Filtrar</button></div></form></div></div>

<div class="card mb-3"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>No. empleado</th><th>Empleado</th><th>Puesto histórico</th><th>Departamento</th><th>Sucursal</th><th>KPI con resultado</th><th>KPI totales</th><th>Puntaje acum.</th><th></th></tr></thead><tbody><% employees.forEach(e=>{ %><tr><td><%= e.no_empleado %></td><td><strong><%= e.empleado_nombre %></strong></td><td><%= e.puesto_nombre || '' %></td><td><%= e.departamento_nombre || '' %></td><td><%= e.sucursal_nombre || '' %></td><td><%= e.kpi_capturados %></td><td><%= e.kpi_totales %></td><td><%= e.puntaje_total %></td><td><button type="button" class="btn btn-sm btn-outline-primary js-history-detail" data-employee="<%= e.no_empleado %>"><i class="bi bi-eye me-1"></i>Ver detalle</button></td></tr><% }); %></tbody></table></div></div>

<div class="modal fade history-detail-modal" id="historyEmployeeModal" tabindex="-1" aria-labelledby="historyEmployeeModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <h3 class="modal-title h5 mb-0" id="historyEmployeeModalLabel">Detalle histórico</h3>
          <div class="small text-muted" id="historyDetailPeriod"><%= monthLabel(period.mes) %> <%= period.anio %> · v<%= period.version %></div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <div id="historyDetailLoading" class="text-center py-5">
          <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando…</span></div>
          <div class="text-muted mt-2">Cargando detalle histórico…</div>
        </div>
        <div id="historyDetailError" class="alert alert-danger d-none mb-0"></div>
        <div id="historyDetailContent" class="d-none">
          <div class="row g-2 mb-3" id="historyEmployeeInfo"></div>
          <h4 class="h6 mb-2">KPI del periodo</h4>
          <div class="table-responsive history-detail-table-wrap">
            <table class="table table-sm table-bordered table-hover align-middle mb-0">
              <thead class="table-light">
                <tr><th>KPI</th><th>Objetivo</th><th>Unidad</th><th>Resultado</th><th>Semáforo</th><th>Puntaje base</th><th>Peso</th><th>Ponderado</th><th>Estado</th><th>Aprobado por</th><th>Fecha aprobación</th><th>En revisión por</th><th>Fecha revisión</th><th>Motivo</th><th>Comentario</th></tr>
              </thead>
              <tbody id="historyDetailRows"></tbody>
            </table>
          </div>
          <h4 class="h6 mt-4 mb-2">Retroalimentación</h4>
          <div class="row g-3" id="historyFeedback"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<style>
  .history-detail-modal { --bs-modal-width: min(96vw, 1500px); }
  .history-detail-modal .modal-content { max-height: 92vh; }
  .history-detail-table-wrap { max-height: 48vh; }
  .history-detail-table-wrap thead th { position: sticky; top: 0; z-index: 2; white-space: nowrap; }
  .history-detail-table-wrap td { min-width: 105px; }
  .history-detail-table-wrap td:first-child { min-width: 230px; }
  .history-feedback-box { min-height: 90px; white-space: pre-wrap; }
</style>
<% } %>

<script>
(() => {
  const btn=document.getElementById('analyzeBtn'); if(!btn)return;
  const file=document.getElementById('historyFile'), box=document.getElementById('previewBox'), imp=document.getElementById('importBtn'), asNew=document.getElementById('asNewVersion');
  btn.addEventListener('click',async()=>{
    imp.classList.add('d-none'); box.classList.remove('d-none'); box.innerHTML='<div class="alert alert-info">Analizando archivo…</div>'; asNew.value='0';
    if(!file.files.length){box.innerHTML='<div class="alert alert-warning">Selecciona un archivo .xlsx.</div>';return;}
    const fd=new FormData(); fd.append('archivo',file.files[0]);
    try { const r=await fetch('/admin/historicos/import/preview',{method:'POST',body:fd}); const j=await r.json();
      if(!j.ok){box.innerHTML=`<div class="alert alert-danger"><strong>No se puede importar.</strong><ul class="mb-0">${(j.errors||[]).map(x=>`<li>${esc(x)}</li>`).join('')}</ul></div>`;return;}
      const s=j.stats||{}, ex=j.existing||{}; let html=`<div class="border rounded p-3"><h3 class="h6">${esc(j.monthName)} ${j.year}</h3><div class="row g-2 small"><div class="col-md-3"><strong>Colaboradores:</strong> ${s.employees}</div><div class="col-md-3"><strong>Filas KPI:</strong> ${s.rows}</div><div class="col-md-3"><strong>Resultados capturados:</strong> ${s.captured}</div><div class="col-md-3"><strong>Retroalimentaciones con contenido:</strong> ${s.feedbackWithContent}</div></div><div class="small mt-2"><strong>Estado:</strong> ${s.stateCounts?.aprobado||0} aprobados · ${s.stateCounts?.revision||0} en revisión · ${s.stateCounts?.abierto||0} abiertos</div>`;
      if((j.warnings||[]).length)html+=`<div class="alert alert-warning mt-3 mb-0"><strong>Advertencias:</strong><ul class="mb-0">${j.warnings.map(x=>`<li>${esc(x)}</li>`).join('')}</ul></div>`;
      if(ex.sameHash)html+=`<div class="alert alert-danger mt-3 mb-0">Este mismo archivo ya fue importado.</div>`; else if(ex.hasCurrent){asNew.value='1';html+=`<div class="alert alert-info mt-3 mb-0">Este periodo ya cuenta con un histórico actual. La confirmación importará el archivo como <strong>nueva versión</strong>; la versión anterior no se borrará.</div>`;} html+='</div>'; box.innerHTML=html; if(!ex.sameHash)imp.classList.remove('d-none');
    } catch(e){box.innerHTML='<div class="alert alert-danger">No fue posible analizar el archivo.</div>';}
  });
  function esc(x){return String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
})();
</script>
<% if (period) { %>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const modalEl = document.getElementById('historyEmployeeModal');
  if (!modalEl) return;

  const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
  const loading = document.getElementById('historyDetailLoading');
  const errorBox = document.getElementById('historyDetailError');
  const content = document.getElementById('historyDetailContent');
  const infoBox = document.getElementById('historyEmployeeInfo');
  const rowsBox = document.getElementById('historyDetailRows');
  const feedbackBox = document.getElementById('historyFeedback');
  const title = document.getElementById('historyEmployeeModalLabel');
  const periodId = <%= Number(period.id) %>;

  document.querySelectorAll('.js-history-detail').forEach(btn => {
    btn.addEventListener('click', () => loadDetail(btn.dataset.employee));
  });

  async function loadDetail(noEmpleado) {
    resetModal();
    modal.show();
    try {
      const r = await fetch(`/admin/historicos/periodo/${periodId}/empleado/${encodeURIComponent(noEmpleado)}`, {
        headers: { 'Accept': 'application/json' }
      });
      const j = await r.json().catch(() => ({}));
      if (!r.ok || !j.ok) throw new Error(j.error || 'No se pudo consultar el detalle histórico.');
      renderDetail(j.detail);
    } catch (e) {
      loading.classList.add('d-none');
      content.classList.add('d-none');
      errorBox.textContent = e.message || 'No se pudo consultar el detalle histórico.';
      errorBox.classList.remove('d-none');
    }
  }

  function resetModal() {
    title.textContent = 'Detalle histórico';
    loading.classList.remove('d-none');
    errorBox.classList.add('d-none');
    errorBox.textContent = '';
    content.classList.add('d-none');
    infoBox.innerHTML = '';
    rowsBox.innerHTML = '';
    feedbackBox.innerHTML = '';
  }

  function renderDetail(detail) {
    const rows = Array.isArray(detail?.details) ? detail.details : [];
    if (!rows.length) throw new Error('No se encontró información histórica para este empleado.');
    const info = rows[0];
    title.textContent = `Detalle histórico · ${info.empleado_nombre || info.no_empleado || ''}`;

    infoBox.innerHTML = [
      infoCard('No. empleado', info.no_empleado),
      infoCard('Empleado', info.empleado_nombre),
      infoCard('Puesto histórico', info.puesto_nombre),
      infoCard('Departamento', info.departamento_nombre),
      infoCard('Sucursal', info.sucursal_nombre)
    ].join('');

    rowsBox.innerHTML = rows.map(d => `<tr>
      <td><strong>${esc(d.kpi_nombre)}</strong></td>
      <td>${esc(d.objetivo)}</td>
      <td>${esc(d.unidad)}</td>
      <td>${esc(value(d.resultado))}</td>
      <td>${esc(d.semaforo)}</td>
      <td>${esc(value(d.puntaje_base))}</td>
      <td>${esc(value(d.peso))}</td>
      <td>${esc(value(d.puntaje_ponderado))}</td>
      <td>${esc(d.estado)}</td>
      <td>${esc(d.aprobado_por_nombre)}</td>
      <td>${esc(fmtDate(d.fecha_aprobacion))}</td>
      <td>${esc(d.revision_por_nombre)}</td>
      <td>${esc(fmtDate(d.fecha_revision))}</td>
      <td>${esc(d.motivo_revision)}</td>
      <td>${esc(d.comentario_kpi)}</td>
    </tr>`).join('');

    const fb = detail.feedback || {};
    feedbackBox.innerHTML = [
      feedbackCard('Fortalezas', fb.fortalezas),
      feedbackCard('Áreas de oportunidad', fb.areas_oportunidad),
      feedbackCard('Compromisos', fb.compromisos)
    ].join('');

    loading.classList.add('d-none');
    errorBox.classList.add('d-none');
    content.classList.remove('d-none');
  }

  function infoCard(label, val) {
    return `<div class="col-sm-6 col-xl"><div class="border rounded p-2 h-100"><div class="small text-muted">${esc(label)}</div><strong>${esc(val || '—')}</strong></div></div>`;
  }
  function feedbackCard(label, val) {
    return `<div class="col-lg-4"><strong>${esc(label)}</strong><div class="border rounded p-2 mt-1 history-feedback-box">${esc(val || '—')}</div></div>`;
  }
  function value(v) { return v === null || v === undefined ? '' : v; }
  function fmtDate(v) {
    if (!v) return '';
    const d = new Date(v);
    return Number.isNaN(d.getTime()) ? '' : d.toLocaleString('es-MX');
  }
  function esc(x) {
    return String(x ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }
});
</script>
<% } %>
<%- include('partials/footer'); %>
